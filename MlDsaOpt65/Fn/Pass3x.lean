import MlDsaOpt65.Fn.Pass3x.Blocks
set_option warningAsError true
/-!
# `pass3x5 … pass3x8`: mixed row-group-1 accumulation (ML-DSA-65, v3)

Generated by `Gen.gen_pass3x` (`scripts/gen_opt.py`): entry stack `[ret]`, a loop
over `t < 256` that reads `X = ABUF[t]`, the `ẑ` words and `ACC + 0x2000`, and
writes only `ACC + 0x2000`. ABUF slot `s` of group `g` holds row-group-1
instance `i` (row `4 + i % 2`, column `i / 2`, `Main/Inv.lean` `okI`); each term
moves the slot's lane to lane `i % 2` (masks, shifts by multiples of 64) and
multiplies by `ẑ_{i / 2}[t]`:

| routine | terms |
|---|---|
| `pass3x5` | `(X & (L0‖L1)) · ẑ_0 + ((X & L2) >> 128) · ẑ_1` |
| `pass3x6` | `((X & L0) << 64) · ẑ_1 + ((X & (L1‖L2)) >> 64) · ẑ_2` |
| `pass3x7` | `(X & (L0‖L1)) · ẑ_3 + ((X & L2) >> 128) · ẑ_4` |
| `pass3x8` | `((X & L0) << 64) · ẑ_4` |

(`ẑ_j` is lane `j % 4` of `ZH + 0x2000 (j / 4)`.) Every opcode is modulo
`2^256`, so the word equations below are exact; the lane split is the
consumer's (candidates `< 2^23`, `ẑ` lanes `< 2^28`: no carries).

Proof: per-routine loop bodies in `Pass3x/Blocks.lean`, the loop skeleton
`p3x_loop` and the mask algebra in `Pass3x/Common.lean`. Gas: entry 3, 256
iterations of 150 / 162 / 144 / 100, `POP` 2, returning `JUMP` 8.
-/

namespace MlDsaOpt65.Proofs

open EvmSemantics
open EvmSemantics.EVM
open MlDsaOptCommon
open MlDsa
open MlDsaOpt65.Proofs.Infra

/-- **pass3x5** (group 5). -/
theorem pass3x5_call {s : State} (hs : Ctx s) {ret : Nat} {tail : List UInt256}
    (hr : RetOK Stack.pass3x ret tail) (m : ByteArray) :
    ∃ m', (∀ t, t < 256 → word m' (ACC + 0x2000 + 32 * t) =
        (word m (ACC + 0x2000 + 32 * t) +
          word m (ABUF + 32 * t) % 2 ^ 128 * lane (word m (ZH + 32 * t)) 0 +
          lane (word m (ABUF + 32 * t)) 2 * lane (word m (ZH + 32 * t)) 1) % 2 ^ 256) ∧
      FrameExcept m m' [(ACC + 0x2000, ACC + 0x4000)] ∧
      Call s Entry.pass3x5 [] ret tail m [] m' Gas.pass3x5 := by
  have htail : tail.length ≤ 1000 := by
    have := hr.depth; simp only [Stack.pass3x, Stack.leaf] at this; omega
  have hret := hr.small
  have hentry : Reach (callState s 11268 (wd ret :: tail) m) (callState s 11270 (wd 0 :: wd ret :: tail) m) 3 := by
    opt65_reach [4692, 4693]
  have hl := Pass3xP.p3x_loop (s := s) (pc := 11270) (pcJ := 11389) (c := 150) (ret := ret) (tail := tail)
    (B := ACC + 0x2000) m Pass3xP.v5 (fun j hj => Pass3xP.read5 m _ hj)
    (fun M o ho => Pass3xP.body5 hs htail M ho) (fun M => Pass3xP.exit5 hs htail M (by norm_num))
  refine ⟨storeWords m (ACC + 0x2000) (fun t => Pass3xP.v5 m (32 * t)) 256, fun t ht => ?_, ?_, ?_⟩
  · rw [word_storeWords (v := fun t => Pass3xP.v5 m (32 * t)) (i := t) (Nat.mod_lt _ (by norm_num)) 256 ht]
    rfl
  · have h := FrameExcept.storeWords m (ACC + 0x2000) (fun t => Pass3xP.v5 m (32 * t)) 256
    rwa [show ACC + 0x2000 + 32 * 256 = ACC + 0x4000 by omega] at h
  · rw [call_iff, Entry.pass3x5, Gas.pass3x5]
    exact ((hentry.trans hl).trans
      (GroupP.reach_ret hs 4742 _ (by decide +kernel) (by simp only [finVal_lit, instrAt_lit])
        (by simp only [finVal_lit, pcAt_lit]) (by norm_num) hr.jumpdest hret (by omega))).of_eq
      (by simp) (by simp)

