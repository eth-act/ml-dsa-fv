/-- The window sum (all τ loads). -/
def sW (m0 M : ByteArray) (bu : Nat) : UInt256 :=
  ld2 M bu (ld1 M bu (ld0 M bu (word m0 49152) (word m0 49184) (word m0 49216) (word m0 49248) (word m0 49280) (word m0 49312) (word m0 49344) (word m0 49376) (word m0 49408) (word m0 49440) (word m0 49472)))
/-- The transposed window sum. -/
def sT (m0 M : ByteArray) (bu cw sp : Nat) (g : UInt256) : UInt256 := c4T M bu cw sp g (sW m0 M bu)

/-- Memory after one iteration. -/
def csMem (m0 M : ByteArray) (bu cw sp : Nat) (g : UInt256) : ByteArray :=
  MachineState.writeBytes (MachineState.writeBytes (MachineState.writeBytes (MachineState.writeBytes M
    (Data.Bytes.natToBytesPadded (c4w0 M cw g (sT m0 M bu cw sp g)).toNat 32) sp)
    (Data.Bytes.natToBytesPadded (c4w1 M cw g (sT m0 M bu cw sp g)).toNat 32) (32 + sp))
    (Data.Bytes.natToBytesPadded (c4w2 M cw g (sT m0 M bu cw sp g)).toNat 32) (64 + sp))
    (Data.Bytes.natToBytesPadded (c4w3 M cw g (sT m0 M bu cw sp g)).toNat 32) (96 + sp)

theorem cs_iter {s : State} (hs : Ctx s) {rest : List UInt256} (hrest : rest.length ≤ 963)
    (m0 M : ByteArray) (bu cw sp : Nat) (g : UInt256)
    (hbu1 : 32 ≤ bu) (hbu : bu ≤ 26624) (hcw : 12288 ≤ cw) (hcw2 : cw + 128 ≤ 20480)
    (hsp : 32768 ≤ sp) (hsp2 : sp + 128 ≤ 49152)
    (hB : ∀ m, m < 49 → word M (49152 + 32 * m) ≤ 6112)
    (hb0 : ∀ i, i < 11 → word m0 (49152 + 32 * i) ≤ 6112) (hlt : cw + 128 < 20480) :
    Reach (callState s 15613 (wd bu :: wd cw :: g :: wd sp :: wd (word m0 49472) :: wd (word m0 49440) :: wd (word m0 49408) :: wd (word m0 49376) :: wd (word m0 49344) :: wd (word m0 49312) :: wd (word m0 49280) :: wd (word m0 49248) :: wd (word m0 49216) :: wd (word m0 49184) :: wd (word m0 49152) :: rest) M)
      (callState s 15613 (wd (bu - 32) :: wd (128 + cw) :: c4g4 M cw g :: wd (128 + sp) :: wd (word m0 49472) :: wd (word m0 49440) :: wd (word m0 49408) :: wd (word m0 49376) :: wd (word m0 49344) :: wd (word m0 49312) :: wd (word m0 49280) :: wd (word m0 49248) :: wd (word m0 49216) :: wd (word m0 49184) :: wd (word m0 49152) :: rest)
        (csMem m0 M bu cw sp g)) 1188 :=
  ((((cs_b0 hs hrest M bu cw sp g (hb0 0 (by norm_num)) (hb0 1 (by norm_num)) (hb0 2 (by norm_num)) (hb0 3 (by norm_num)) (hb0 4 (by norm_num)) (hb0 5 (by norm_num)) (hb0 6 (by norm_num)) (hb0 7 (by norm_num)) (hb0 8 (by norm_num)) (hb0 9 (by norm_num)) (hb0 10 (by norm_num)) hbu1 hbu hcw hcw2 hsp hsp2 hB).trans
    (cs_b1 hs hrest M bu cw sp g _ hbu1 hbu hcw hcw2 hsp hsp2 hB)).trans
    (cs_b2 hs hrest M bu cw sp g _ hbu1 hbu hcw hcw2 hsp hsp2 hB)).trans
    (cs_tp hs hrest M bu cw sp g _)).trans
    (cs_em hs hrest M bu cw sp g _ hbu1 hbu hcw hcw2 hsp hsp2 hB hlt)

theorem cs_iterx {s : State} (hs : Ctx s) {rest : List UInt256} (hrest : rest.length ≤ 963)
    (m0 M : ByteArray) (bu cw sp : Nat) (g : UInt256)
    (hbu1 : 32 ≤ bu) (hbu : bu ≤ 26624) (hcw : 12288 ≤ cw) (hcw2 : cw + 128 ≤ 20480)
    (hsp : 32768 ≤ sp) (hsp2 : sp + 128 ≤ 49152)
    (hB : ∀ m, m < 49 → word M (49152 + 32 * m) ≤ 6112)
    (hb0 : ∀ i, i < 11 → word m0 (49152 + 32 * i) ≤ 6112) (hlt : cw + 128 = 20480) :
    Reach (callState s 15613 (wd bu :: wd cw :: g :: wd sp :: wd (word m0 49472) :: wd (word m0 49440) :: wd (word m0 49408) :: wd (word m0 49376) :: wd (word m0 49344) :: wd (word m0 49312) :: wd (word m0 49280) :: wd (word m0 49248) :: wd (word m0 49216) :: wd (word m0 49184) :: wd (word m0 49152) :: rest) M)
      (callState s 16258 (wd (bu - 32) :: wd (128 + cw) :: c4g4 M cw g :: wd (128 + sp) :: wd (word m0 49472) :: wd (word m0 49440) :: wd (word m0 49408) :: wd (word m0 49376) :: wd (word m0 49344) :: wd (word m0 49312) :: wd (word m0 49280) :: wd (word m0 49248) :: wd (word m0 49216) :: wd (word m0 49184) :: wd (word m0 49152) :: rest)
        (csMem m0 M bu cw sp g)) 1188 :=
  ((((cs_b0 hs hrest M bu cw sp g (hb0 0 (by norm_num)) (hb0 1 (by norm_num)) (hb0 2 (by norm_num)) (hb0 3 (by norm_num)) (hb0 4 (by norm_num)) (hb0 5 (by norm_num)) (hb0 6 (by norm_num)) (hb0 7 (by norm_num)) (hb0 8 (by norm_num)) (hb0 9 (by norm_num)) (hb0 10 (by norm_num)) hbu1 hbu hcw hcw2 hsp hsp2 hB).trans
    (cs_b1 hs hrest M bu cw sp g _ hbu1 hbu hcw hcw2 hsp hsp2 hB)).trans
    (cs_b2 hs hrest M bu cw sp g _ hbu1 hbu hcw hcw2 hsp hsp2 hB)).trans
    (cs_tp hs hrest M bu cw sp g _)).trans
    (cs_emx hs hrest M bu cw sp g _ hbu1 hbu hcw hcw2 hsp hsp2 hB hlt)

end MlDsaOpt65.Proofs.G4
