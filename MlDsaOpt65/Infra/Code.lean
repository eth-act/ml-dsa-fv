theorem checkAll_append (t : BTree Instr) (p : BTree Nat) (l₁ l₂ : List Instr) (k pc : Nat)
    (h₁ : checkAll t p k pc l₁ = true)
    (h₂ : checkAll t p (k + l₁.length) (pc + (l₁.map isz).sum) l₂ = true) :
    checkAll t p k pc (l₁ ++ l₂) = true := by
  induction l₁ generalizing k pc with
  | nil => simpa using h₂
  | cons i is ih =>
    have e1 : k + (i :: is).length = k + 1 + is.length := by
      simp only [List.length_cons]; omega
    have e2 : pc + ((i :: is).map isz).sum = pc + isz i + (is.map isz).sum := by
      simp only [List.map_cons, List.sum_cons]; omega
    rw [e1, e2] at h₂
    simp only [List.cons_append, checkAll, Bool.and_eq_true] at h₁ ⊢
    exact ⟨h₁.1, ih (k + 1) (pc + isz i) h₁.2 h₂⟩

