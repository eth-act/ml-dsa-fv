/-- Discharge a callee's `RetOK` at a call site. The caller holds
`hr : RetOK B ret tail`; at the call the callee's tail is `extra ++ tail`. -/
theorem MlDsaOpt65.Proofs.RetOK.callee {B B' ret ret' : Nat} {tail extra : List EvmSemantics.UInt256}
    (hr : MlDsaOpt65.Proofs.RetOK B ret tail) (hB : B' + extra.length ≤ B)
    (hj : EvmSemantics.EVM.Decode.isValidJumpDest MlDsaOpt65.optBytecode ret' = true)
    (hsmall : ret' < 2 ^ 16) :
    MlDsaOpt65.Proofs.RetOK B' ret' (extra ++ tail) :=
  ⟨hj, hsmall, by have := hr.depth; simp only [List.length_append]; omega⟩

