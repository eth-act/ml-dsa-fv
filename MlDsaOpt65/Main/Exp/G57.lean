import MlDsaOpt65.Main.Exp.G57.Grp5
import MlDsaOpt65.Main.Exp.G57.Grp6
import MlDsaOpt65.Main.Exp.G57.Grp7
set_option warningAsError true
/-! # ExpandA, pc `3674 … 5022`: the mixed groups 5, 6, 7 (ML-DSA-65, v4)

Three groups of three row-group-1 instances (`i0 = 0, 3, 6`, slots 0 … 2) with
the `tr` rider in slot 3 (blocks `0 … 14` of the padded public key; kept by
`ginit` in groups 6 and 7), each followed by `gfix 7` and the copy of `ABUF` to
its side buffer (`CW`, `HP`, `HP + 0x2000`). Group 7 absorbs the short last
block (`trabs` with two lane groups, then the two padding xors) and extracts
`tr` into `TRL`. The groups are in `Exp/G57/Grp{5,6,7}.lean` (generated by a
script from `listing.tsv`; the glue costs are the static opcode sums). -/

namespace MlDsaOpt65.Proofs

open MlDsaOpt44.Proofs
open EvmSemantics
open EvmSemantics.EVM
open MlDsaOptCommon
open MlDsa44
open MlDsaOpt65.Proofs.Infra
open MlDsaOpt65.Proofs.G57

namespace Exp

/-- The static cost of `3674 … 5022`: glue plus the calls of the three groups. -/
def gG57 : Nat := G57.cost5 + G57.cost6 + G57.cost7

theorem g57_flag (cd : ByteArray) (b : Bool) :
    (((b && (okI cd 0 && okI cd (0 + 1) && okI cd (0 + 2))) && (okI cd 3 && okI cd (3 + 1) && okI cd (3 + 2))) &&
      (okI cd 6 && okI cd (6 + 1) && okI cd (6 + 2))) = (b && okIUpTo cd 9) := by
  simp only [okIUpTo, Nat.reduceAdd, Bool.true_and]
  generalize okI cd 0 = a0; generalize okI cd 1 = a1; generalize okI cd 2 = a2
  generalize okI cd 3 = a3; generalize okI cd 4 = a4; generalize okI cd 5 = a5
  generalize okI cd 6 = a6; generalize okI cd 7 = a7; generalize okI cd 8 = a8
  simp only [Bool.and_assoc]

theorem exp_g57 {s : State} (hs : Ctx s) (hcd : HDR ≤ s.executionEnv.calldata.size) {m : ByteArray}
    (hI : PureOut s.executionEnv.calldata m) (b : Bool) :
    ∃ m', InvG8 s.executionEnv.calldata m' ∧
      Reach (callState s 3674 [flag b] m)
        (callState s 5022 [flag (b && okIUpTo s.executionEnv.calldata 9)] m') gG57 := by
  obtain ⟨m5, hks5, hl5, hrc5, hf5, hR5⟩ := grp5 hs hcd (b := b) hI.rc4 hI.rho
  obtain ⟨m6, hks6, hl6, hrc6, hf6, hR6⟩ := grp6 hs hcd hrc5 (hI.rho.frame hf5 (by g57_frame)) hks5
  have hf56 := FrameExcept.trans hf5 hf6
  obtain ⟨m7, -, hl7, htrl, hrc7, hf7, hR7⟩ := grp7 hs hcd hrc6 (hI.rho.frame hf56 (by g57_frame)) hks6
  have hf67 := FrameExcept.trans hf6 hf7
  have hfA := FrameExcept.trans hf56 hf7
  refine ⟨m7, ⟨hrc7, RC1Table.frame hI.rc1 hfA (by g57_frame), TblAt.frame hI.tbl hfA (by g57_frame),
    zhat_frame hI.zhat hfA (by g57_frame), hI.rho.frame hfA (by g57_frame),
    acc0_frame hI.acc0 hfA (by g57_frame) (by g57_frame),
    (mixBuf_of (by norm_num) hl5).frame hf67 (by g57_frame),
    (mixBuf_of (by norm_num) hl6).frame hf7 (by g57_frame),
    mixBuf_of (by norm_num) hl7, htrl,
    ZeroOn.frame hI.zNeg hfA (by g57_frame), ZeroOn.frame hI.zBases hfA (by g57_frame),
    ZeroOn.frame hI.zIdx hfA (by g57_frame)⟩, ?_⟩
  have hR := (hR5.trans hR6).trans hR7
  rw [g57_flag] at hR
  exact hR.mono (le_of_eq (by unfold gG57; omega))

end Exp

end MlDsaOpt65.Proofs
