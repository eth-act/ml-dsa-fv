                if gt(idx, index) {
                    if iszero(lt(byte(0, calldataload(add(5199, idx))), y)) { good := 0 }
                }
                mstore8(add(0x149e0, add(shl(8, i), y)), 1)
            }
            index := bound
        }
        for { let idx := index } lt(idx, 55) { idx := add(idx, 1) } {
            if byte(0, calldataload(add(5200, idx))) { good := 0 }
        }
    }

    // z (BitUnpack, gamma1 = 2^19) into ZH as Z_q values, then NTT;
    // returns 1 if ||z||_inf < gamma1 - beta.
    function decodeZ() -> good {
        good := 1
        for { let i := 0 } lt(i, 5) { i := add(i, 1) } {
            let base := add(0x29e0, shl(13, i))
            for { let j := 0 } lt(j, 256) { j := add(j, 1) } {
                let raw := unpack(add(2000, mul(640, i)), j, 20)
                if iszero(and(gt(raw, 196), lt(raw, 1048380))) { good := 0 }
                mstore(add(base, shl(5, j)), addmod(524288, sub(8380417, raw), 8380417))
            }
            ntt(base)
        }
    }

    // UseHint (Algorithm 40) for r in [0, q), h in {0, 1}.
    function useHint(hb, r) -> r1 {
        let r0u := mod(r, 523776)
        let neg := gt(r0u, 261888)
        let hi := add(sub(r, r0u), mul(neg, 523776))
        let r0pos := and(iszero(neg), gt(r0u, 0))
        switch eq(hi, 8380416)
        case 1 {
            r1 := 0
            r0pos := 0
        }
        default { r1 := div(hi, 523776) }
        if hb {
            switch r0pos
            case 1 { r1 := mod(add(r1, 1), 16) }
            default { r1 := mod(add(r1, 15), 16) }
        }
    }

    // w1Encode row i of UseHint(h[i], ACC) into W1 + 64 + 128 i.
    function encodeRow(i) {
        let out := add(0x15540, add(64, mul(128, i)))
        let hrow := add(0x149e0, shl(8, i))
        for { let g := 0 } lt(g, 64) { g := add(g, 1) } {
            let v := 0
            for { let e := 0 } lt(e, 4) { e := add(e, 1) } {
                let t := add(shl(2, g), e)
                let w := useHint(byte(0, mload(add(hrow, t))), mload(add(0x109e0, shl(5, t))))
                v := or(v, shl(mul(4, e), w))
            }
            let o := add(out, mul(2, g))
            mstore8(o, and(v, 0xff))
            mstore8(add(o, 1), shr(8, v))
        }
    }

    // Row i of NTT^-1(A z-hat - c-hat t1-hat) into ACC; returns 0 if
    // RejNTTPoly ran out of XOF output.
    function computeRow(i) -> good {
        good := 1
        zeroPoly(0x109e0)
        for { let j := 0 } lt(j, 5) { j := add(j, 1) } {
            mstore8(add(0x15400, 32), j)
            mstore8(add(0x15400, 33), i)
            shake(168, 0x15400, 34, 0x14fe0, 6)
            good := and(good, rejSample(0xe9e0))
            let zj := add(0x29e0, shl(13, j))
            for { let t := 0 } lt(t, 256) { t := add(t, 1) } {
                let o := shl(5, t)
                let a := add(0x109e0, o)
                mstore(a, addmod(mload(a), mulmod(mload(add(0xe9e0, o)), mload(add(zj, o)), 8380417), 8380417))
            }
        }
        for { let t := 0 } lt(t, 256) { t := add(t, 1) } {
            mstore(add(0x129e0, shl(5, t)), shl(13, unpack(add(32, mul(320, i)), t, 10)))
        }
        ntt(0x129e0)
        for { let t := 0 } lt(t, 256) { t := add(t, 1) } {
            let o := shl(5, t)
            let a := add(0x109e0, o)
            let ct := mulmod(mload(add(0xc9e0, o)), mload(add(0x129e0, o)), 8380417)
            mstore(a, addmod(mload(a), sub(8380417, ct), 8380417))
        }
        nttInv(0x109e0)
    }

    if lt(calldatasize(), 5261) {
        mstore(0, 0)
        return(0, 32)
    }

    // Touch the highest address any later access reaches, so memory size is
    // fixed for the rest of the execution.
    let mlen := sub(calldatasize(), 5261)
    mstore(add(0x16040, add(mlen, 256)), 0)

    mstore(0x6e0, 0x1)
    mstore(0x700, 0x8082)
    mstore(0x720, 0x800000000000808a)
    mstore(0x740, 0x8000000080008000)
    mstore(0x760, 0x808b)
    mstore(0x780, 0x80000001)
    mstore(0x7a0, 0x8000000080008081)
    mstore(0x7c0, 0x8000000000008009)
    mstore(0x7e0, 0x8a)
    mstore(0x800, 0x88)
    mstore(0x820, 0x80008009)
    mstore(0x840, 0x8000000a)
    mstore(0x860, 0x8000808b)
    mstore(0x880, 0x800000000000008b)
    mstore(0x8a0, 0x8000000000008089)
    mstore(0x8c0, 0x8000000000008003)
    mstore(0x8e0, 0x8000000000008002)
    mstore(0x900, 0x8000000000000080)
    mstore(0x920, 0x800a)
    mstore(0x940, 0x800000008000000a)
    mstore(0x960, 0x8000000080008081)
    mstore(0x980, 0x8000000000008080)
    mstore(0x9a0, 0x80000001)
    mstore(0x9c0, 0x8000000080008008)
    initZetas()

    // tr = H(pk, 64); mu = H(tr || 0 || 0 || M, 64).
    calldatacopy(0x15880, 0, 1952)
    shake(136, 0x15880, 1952, 0x16040, 1)
    mstore8(add(0x16040, 64), 0)
    mstore8(add(0x16040, 65), 0)
    calldatacopy(add(0x16040, 66), 5261, mlen)
    shake(136, 0x16040, add(66, mlen), 0x15540, 1)

    let ok := decodeZ()
    ok := and(ok, decodeHint())

    calldatacopy(0x15440, 1952, 48)
    shake(136, 0x15440, 48, 0x14fe0, 2)
    ok := and(ok, sampleInBall())
    ntt(0xc9e0)

    calldatacopy(0x15400, 0, 32)
    for { let i := 0 } lt(i, 6) { i := add(i, 1) } {
        ok := and(ok, computeRow(i))
        encodeRow(i)
    }

    shake(136, 0x15540, 832, 0x14fe0, 1)
    ok := and(ok, eq(mload(0x14fe0), calldataload(1952)))
    ok := and(ok, eq(shr(128, mload(0x15000)), shr(128, calldataload(1984))))
    mstore(0, ok)
    return(0, 32)
}
