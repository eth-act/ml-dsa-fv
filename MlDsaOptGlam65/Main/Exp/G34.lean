import MlDsaOptGlam65.Main.Exp.G.Grp3
import MlDsaOptGlam65.Main.Exp.G.Grp4
set_option warningAsError true
/-!
# ExpandA, calls 15–24: rows 4 and 5 (glam ML-DSA-65)

`2588 … 2909`: two inline groups (`G/Grp3.lean`, `G/Grp4.lean`, generated by
`G/gen.py`): `HAVE6 := 0`, `ginit [0, 15, 0, l4]` (slot `k` the seed of
`A[r][3 − k]`), five `kf4` with `blk` (`blkh` for block 4), `gfix 15`, `AND`,
and the copy of `ABUF` to `ACC + 0x2000` (row 4) and `SB` (row 5) (`RowBuf`).
-/

namespace MlDsaOptGlam65.Proofs

open MlDsaOpt65.Proofs

open EvmSemantics
open EvmSemantics.EVM
open MlDsaOptCommon
open MlDsa

namespace Exp

/-- Calls 15–24: per group glue 32 (`HAVE6`, `ginit` pushes), five times 15 + 21
(`kf4`, `blk` pushes), 18 (`gfix` pushes), 13 (`AND`, `MCOPY` pushes), 771 (`MCOPY`);
`ginit`, five `kf4`, four `blk`, one `blkh`, `gfix 4`. -/
def gG34 : Nat :=
  2 * (32 + 5 * (15 + 21) + 18 + 13 + 771) +
    2 * Gas.ginit + 10 * Gas.kf4 + 8 * Gas.blk + 2 * Gas.blkh + 2 * Gas.gfix 4

set_option maxRecDepth 10000 in
set_option maxHeartbeats 1000000 in
theorem exp_g34 {s : State} (hs : Ctx s) (hcd : HDR ≤ s.executionEnv.calldata.size) {m : ByteArray}
    (hI : G3In s.executionEnv.calldata m) (b : Bool) :
    ∃ m', G5In s.executionEnv.calldata m' ∧
      Reach (callState s 2588 [flag b] m)
        (callState s 2909 [flag ((b && okRow s.executionEnv.calldata 4) && okRow s.executionEnv.calldata 5)] m')
        gG34 := by
  obtain ⟨m1, r4, hf1, hR1⟩ := G.grp3 hs hcd (b := b) hI.rc4 hI.rho
  obtain ⟨m2, r5, hf2, hR2⟩ := G.grp4 hs hcd (b := b && okRow s.executionEnv.calldata 4)
    (RC4Table.frame hI.rc4 hf1 (by expg_frame)) (Rho1At.frame hI.rho hf1 (by expg_frame))
  have hf := hf1.trans hf2
  refine ⟨m2, ⟨⟨RC4Table.frame hI.rc4 hf (by expg_frame), RC1Table.frame hI.rc1 hf (by expg_frame),
    TblAt.frame hI.tbl hf (by expg_frame), ZHatAt.frame hI.zhat hf (by expg_frame),
    Rho1At.frame hI.rho hf (by expg_frame), hI.c0.frame hf (by expg_frame),
    hI.c1.frame hf (by expg_frame), hI.c2.frame hf (by expg_frame),
    ZeroOn.frame hI.zNeg hf (by expg_frame), ZeroOn.frame hI.zBases hf (by expg_frame),
    ZeroOn.frame hI.zIdx hf (by expg_frame)⟩, r4.frame hf2 (by expg_frame), r5⟩, ?_⟩
  refine (hR1.trans hR2).mono (le_of_eq ?_)
  unfold gG34 G.cost3 G.cost4
  generalize Gas.ginit = a1; generalize Gas.kf4 = a4; generalize Gas.blk = a5
  generalize Gas.blkh = a6; generalize Gas.gfix 4 = a8
  omega

end Exp

end MlDsaOptGlam65.Proofs
