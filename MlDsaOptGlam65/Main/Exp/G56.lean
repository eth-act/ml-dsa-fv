import MlDsaOptGlam65.Main.Exp.G.Grp5
import MlDsaOptGlam65.Main.Exp.G.Grp6
set_option warningAsError true
/-!
# ExpandA, calls 25–34: `tr` and rows 0 … 2 of columns 3, 4 (glam ML-DSA-65)

`2909 … 3739`: two inline groups (`G/Grp5.lean`, `G/Grp6.lean`, generated by
`G/gen.py`): `HAVE6 := 0`, `ginit [keep, 14, 0, l4]` (slot 0 `tr`: fresh, then
kept; slot `k ≥ 1` the seed of `A[k − 1][col]`), five times `trabs` (block `j`
of the padded public key into slot 0), `kf4`, `blk` (`blkh` for block 4),
`gfix 14`, `AND`, and the copy of `ABUF` to `ACC` (column 3) and `SB + 0x2000`
(column 4) (`Col3Hi`). `tr`'s sponge after blocks `0 … 9` stays in slot 0.
-/

namespace MlDsaOptGlam65.Proofs

open MlDsaOpt65.Proofs

open EvmSemantics
open EvmSemantics.EVM
open MlDsaOptCommon
open MlDsa

namespace Exp

/-- Calls 25–34: glue 32 / 33 (`HAVE6`, `ginit` pushes; group 6 pushes a 32-byte
keep mask), five `trabs` pushes (27 for block 0, else 28), five times 15 + 21
(`kf4`, `blk` pushes), 18 (`gfix` pushes), 13 (`AND`, `MCOPY` pushes), 771
(`MCOPY`); per group `ginit`, five `trabs 5`, five `kf4`, four `blk`, one
`blkh`, `gfix 3`. -/
def gG56 : Nat :=
  (32 + 27 + 4 * 28) + (33 + 5 * 28) + 2 * (5 * (15 + 21) + 18 + 13 + 771) +
    2 * Gas.ginit + 10 * Gas.trabs 5 + 10 * Gas.kf4 + 8 * Gas.blk + 2 * Gas.blkh + 2 * Gas.gfix 3

set_option maxRecDepth 10000 in
set_option maxHeartbeats 1000000 in
theorem exp_g56 {s : State} (hs : Ctx s) (hcd : HDR ≤ s.executionEnv.calldata.size) {m : ByteArray}
    (hI : G5In s.executionEnv.calldata m) (b : Bool) :
    ∃ m', WinIn s.executionEnv.calldata m' ∧
      Reach (callState s 2909 [flag b] m)
        (callState s 3739 [flag ((b && okCol3 s.executionEnv.calldata 3) && okCol3 s.executionEnv.calldata 4)] m')
        gG56 := by
  obtain ⟨m1, ks1, c3, hf1, hR1⟩ := G.grp5 hs hcd (b := b) hI.rc4 hI.rho
  obtain ⟨m2, ks2, c4, hf2, hR2⟩ := G.grp6 hs hcd (b := b && okCol3 s.executionEnv.calldata 3)
    (RC4Table.frame hI.rc4 hf1 (by expg_frame)) (Rho1At.frame hI.rho hf1 (by expg_frame)) ks1
  have hf := hf1.trans hf2
  refine ⟨m2, ⟨⟨⟨RC4Table.frame hI.rc4 hf (by expg_frame), RC1Table.frame hI.rc1 hf (by expg_frame),
    TblAt.frame hI.tbl hf (by expg_frame), ZHatAt.frame hI.zhat hf (by expg_frame),
    Rho1At.frame hI.rho hf (by expg_frame), hI.c0.frame hf (by expg_frame),
    hI.c1.frame hf (by expg_frame), hI.c2.frame hf (by expg_frame),
    ZeroOn.frame hI.zNeg hf (by expg_frame), ZeroOn.frame hI.zBases hf (by expg_frame),
    ZeroOn.frame hI.zIdx hf (by expg_frame)⟩, hI.r4.frame hf (by expg_frame),
    hI.r5.frame hf (by expg_frame)⟩, c3.frame hf2 (by expg_frame), c4,
    ⟨G.XT s.executionEnv.calldata 4 5 5, G.XT_sized _ 4 5 5, ks2, ?_⟩⟩, ?_⟩
  · unfold G.XT padPk
    rw [if_pos rfl]
  · refine (hR1.trans hR2).mono (le_of_eq ?_)
    unfold gG56 G.cost5 G.cost6
    generalize Gas.ginit = a1; generalize Gas.trabs 5 = a2; generalize Gas.kf4 = a4
    generalize Gas.blk = a5; generalize Gas.blkh = a6; generalize Gas.gfix 3 = a8
    omega

end Exp

end MlDsaOptGlam65.Proofs
