theorem arr25 {A : Array UInt64} (h : A.size = 25) : A = #[A[0]!, A[1]!, A[2]!, A[3]!, A[4]!, A[5]!, A[6]!, A[7]!, A[8]!, A[9]!, A[10]!, A[11]!, A[12]!, A[13]!, A[14]!, A[15]!, A[16]!, A[17]!, A[18]!, A[19]!, A[20]!, A[21]!, A[22]!, A[23]!, A[24]!] := by
  rcases A with ⟨l⟩
  simp only [List.size_toArray] at h
  match l, h with
  | [x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17, x18, x19, x20, x21, x22, x23, x24], _ => rfl

theorem iotaY_eq {M : ByteArray} {dst : Nat} {rcA : UInt256} {rc : UInt64}
    (h : mloadY M rcA.toNat = L rc) :
    iotaY M dst rcA = mstoreY M dst (UInt256.xor (mloadY M dst) (L rc)) := by
  rw [iotaY, h]

