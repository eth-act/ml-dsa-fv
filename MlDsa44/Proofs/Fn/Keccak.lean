import MlDsa44.Proofs.Fn.Keccak.IterReach
import MlDsa44.Proofs.Fn.Keccak.IterSpec
/-!
# `keccakF`: Keccak-f[1600] on the lanes at `ST`

Yul: `function keccakF()`; twelve iterations of two straight-line rounds,
`ST → BT` then `BT → ST`, with column parities in `CT` and round constants
read from `RC`.

Proof layout (`Keccak/`):
* `Model`, `Rows`: the Yul-level model (`mloadY`/`mstoreY` and the word
  operations), the row stores, `half1`/`half2` and one loop iteration `iterY`;
* `Blocks1`, `Blocks2`: the fifteen straight-line blocks of one iteration,
  each ending in a state whose memory is given by the model;
  `IterReach` composes them (4524 gas per iteration);
* `Bridge`, `RoundSpec`, `IterSpec`: the model computes `Crypto.Keccak.round`
  lane by lane (`L a` is a lane held in a word).
`Rows`, `Blocks1`, `Blocks2` and `RoundSpec` are generated by `Keccak/gen_keccak.py` from the Yul
source and `docs/reference.listing`.
-/

namespace MlDsa44.Proofs

open EvmSemantics
open EvmSemantics.EVM

-- Gas budget: exact cost, 3 (entry) + 12 · 4524 (iterations) + 37 (exit).
namespace Gas

def keccakF : Nat := 54328

end Gas

namespace KeccakModel

/-- Memory after `k` loop iterations. -/
def memIter (m : ByteArray) : Nat → ByteArray
  | 0 => m
  | k + 1 => iterY (memIter m k) (2 * k)

/-- The first `n` Keccak rounds. -/
def rounds (A : Array UInt64) (n : Nat) : Array UInt64 :=
  (List.range n).foldl (fun A i => Crypto.Keccak.round A Crypto.Keccak.RC[i]!) A

theorem permute_eq (A : Array UInt64) : Crypto.Keccak.permute A = rounds A 24 := by
  simp only [Crypto.Keccak.permute, Std.Legacy.Range.forIn_eq_forIn_range',
    Std.Legacy.Range.size, List.forIn_pure_yield_eq_foldl, Id.run_pure, pure_bind, rounds,
    List.range_eq_range']

theorem rounds_two (A : Array UInt64) (k : Nat) :
    rounds A (2 * k + 2) =
      Crypto.Keccak.round (Crypto.Keccak.round (rounds A (2 * k)) Crypto.Keccak.RC[2 * k]!)
        Crypto.Keccak.RC[2 * k + 1]! := by
  simp only [rounds, List.range_succ, List.foldl_append, List.foldl_cons, List.foldl_nil]

theorem memIter_spec {m : ByteArray} {A : Array UInt64} (hA : LanesAt m ST A)
    (hrc : RCTable m) :
    ∀ k, k ≤ 12 → LanesAt (memIter m k) ST (rounds A (2 * k)) ∧ RCTable (memIter m k) ∧
      FrameExcept m (memIter m k) [(ST, RC)]
  | 0, _ => ⟨by simpa [rounds, memIter] using hA, hrc, Infra.FrameExcept.refl _ _⟩
  | k + 1, hk => by
    obtain ⟨hA', hrc', hf⟩ := memIter_spec hA hrc k (by omega)
    obtain ⟨hA'', hrc'', hf'⟩ := iter_spec hA' hrc' (r := 2 * k) (by omega)
    refine ⟨?_, hrc'', FrameExcept.trans' hf hf'⟩
    rw [show 2 * (k + 1) = 2 * k + 2 by omega, rounds_two]
    exact hA''

end KeccakModel

open KeccakModel in
theorem keccakF_call {s : State} (hs : Ctx s) {ret : Nat} {tail : List UInt256}
    (hr : RetOK Stack.keccakF ret tail) {m : ByteArray} {A : Array UInt64}
    (hA : LanesAt m ST A) (hrc : RCTable m) :
    ∃ m', LanesAt m' ST (Crypto.Keccak.permute A) ∧ FrameExcept m m' [(ST, RC)] ∧
      Call s Entry.keccakF [] ret tail m [] m' Gas.keccakF := by
  have htl : tail.length ≤ 960 := by
    have := hr.depth; simp only [Stack.keccakF, Stack.leaf] at this; omega
  have := hr.small
  have haw : s.activeWords.toNat ≤ 18446744073709551616 := hs.small
  have hsz : 2535 ≤ s.activeWords.toNat := hs.sized
  let I : Nat → State := fun k => callState s 6 (wd (2 * k) :: wd ret :: tail) (memIter m k)
  have hentry : Infra.Reach (callState s 4 (wd ret :: tail) m)
      (callState s 6 (wd 0 :: wd ret :: tail) m) 3 := by
    evm_reach [2, 3]
  have hbody : ∀ k, k < 12 → Infra.Reach (I k) (I (k + 1)) 4524 := by
    intro k hk
    have h := KeccakBlocks.iter_reach (ret := ret) hs htl haw hsz (memIter m k) (2 * k) (by omega)
    simp only [I, memIter]
    rw [show 2 * (k + 1) = 2 * k + 2 by omega]
    exact h
  have hexit : ∀ M, Infra.Reach (callState s 6 (wd 24 :: wd ret :: tail) M)
      (callState s ret tail M) 37 := by
    intro M
    evm_reach [4, 5, 6, 7, 8, 9, 10, 1550, 1551, 1552] with [hr.jumpdest]
  obtain ⟨hL, -, hf⟩ := memIter_spec hA hrc 12 le_rfl
  refine ⟨memIter m 12, by rw [permute_eq]; exact hL, hf, ?_⟩
  rw [Infra.call_iff, Entry.keccakF, Gas.keccakF]
  have h := (hentry.trans (Infra.Reach.loop (I := I) 12 hbody)).trans (hexit (memIter m 12))
  exact (h.mono (by norm_num)).of_eq (by simp) (by simp)

end MlDsa44.Proofs
