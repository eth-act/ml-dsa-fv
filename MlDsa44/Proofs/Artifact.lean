@[simp] theorem referenceInstructions_length : referenceInstructions.length = 3375 := by
  rfl

theorem assemble_referenceInstructions :
    assemble referenceInstructions = MlDsa44.referenceBytecode := by
  rfl

def referenceArtifact : EvmProof.ProgramArtifact where
  code := MlDsa44.referenceBytecode
  instructions := referenceInstructions
  assembly_eq := assemble_referenceInstructions

theorem allWellFormedB :
    referenceInstructions.all (MlDsa44.Proofs.wellFormedB .Osaka) = true := by
  rfl

theorem allWellFormed : EvmProof.Stepper.AllWellFormed referenceArtifact .Osaka :=
  MlDsa44.Proofs.allWellFormed_of_all allWellFormedB

/-- Proof-carrying instruction lookup. -/
def located (index : Fin 3375) : EvmProof.Stepper.Located referenceArtifact .Osaka :=
  EvmProof.Stepper.Located.ofIndex allWellFormed
    ⟨index.val, by rw [referenceArtifact, referenceInstructions_length]; exact index.isLt⟩

/-- A certified path from a list of instruction indices. -/
def locatedPath (indices : List (Fin 3375)) :
    List (EvmProof.Stepper.Located referenceArtifact .Osaka) :=
  indices.map located

