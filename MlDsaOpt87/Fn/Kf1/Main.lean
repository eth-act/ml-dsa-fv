/-!
# `kf1`: Keccak-f on the replicated state in `KS` (WP2)

Proof layout (`Kf1/`):
* `Model`, `Tables`: the word model of a round exactly as the code computes it
  (decaying left shifts, lane-complemented chi, iota, re-replication) and its
  64-bit lane mirror;
* `Blocks1a/1b/2a/2b/3a/3b`, `BlocksLoop` (generated by `gen_kf1.py`): the
  straight-line blocks of one loop iteration, the entry, loop-back and exit;
  `Rounds` composes them into the three rounds `KS → KB → KZ → KS`
  (1224 + 1231 + 1580 gas);
* `Win`: the word model computes the lane mirror on bit windows
  (`[0, 256) → [63, 256) → [126, 256) → [189, 256)`), and the re-replication
  of `[192, 256)`;
* `Lanes`, `Spec`: the lane mirror on stored (complemented) lanes is the
  stored form of `Crypto.Keccak.round`.

Here: one loop iteration (`iter_reach`, `iter_spec`), eight of them, and
`kf1_main` (the statement of `kf1_call`). Gas: `7 + 7 · (4035 + 34) + 4035 + 46 = 32571`.
-/

namespace MlDsaOpt87.Proofs.Kf1

open MlDsaOpt44.Proofs MlDsaOpt44.Proofs.Kf1

open EvmSemantics
open EvmSemantics.EVM
open MlDsaOptCommon
open MlDsa44

/-- The words of `KS`. -/
def A1 (m : ByteArray) (j : Nat) : UInt256 := UInt256.ofNat (word m (0 + 32 * j))

/-- Memory after the first round of an iteration (round constants at `rp`). -/
def mem1 (m : ByteArray) (rp : Nat) : ByteArray :=
  storeWords m 1024 (fun j => (roundW (A1 m) (UInt256.ofNat (word m rp)) j).toNat) 25

/-- The second round's words (in `KZ`). -/
def W2 (m : ByteArray) (rp : Nat) (j : Nat) : UInt256 :=
  roundW (fun j => roundW (A1 m) (UInt256.ofNat (word m rp)) j) (UInt256.ofNat (word m (32 + rp))) j

/-- Memory after the second round of an iteration. -/
def mem2 (m : ByteArray) (rp : Nat) : ByteArray :=
  storeWords (mem1 m rp) 91904 (fun j => (W2 m rp j).toNat) 25

/-- Memory after one loop iteration. -/
def iterMem (m : ByteArray) (rp : Nat) : ByteArray :=
  storeWords (mem2 m rp) 0
    (fun j => (rerepW (roundW (W2 m rp) (UInt256.ofNat (word m (64 + rp))) j)).toNat) 25

/-- Memory after `i` loop iterations. -/
def memIter (m : ByteArray) : Nat → ByteArray
  | 0 => m
  | i + 1 => iterMem (memIter m i) (2816 + 96 * i)

theorem toNat_lt256 (x : UInt256) : x.toNat < 2 ^ 256 := x.val.isLt

theorem frame_storeWords25 {m : ByteArray} {base a : Nat} {v : Nat → Nat}
    (h : a + 32 ≤ base ∨ base + 800 ≤ a) : word (storeWords m base v 25) a = word m a :=
  FrameExcept.word (FrameExcept.storeWords m base v 25) (by
    simp only [avoids_cons, avoids_nil, and_true]; omega)

/-! ## One iteration: trace -/

theorem iter_reach {s : State} (hs : Ctx s) {tail : List UInt256} (htl : tail.length ≤ 960)
    (hsz : 2897 ≤ s.activeWords.toNat) {M : ByteArray} {rp ret : Nat} (hrp : rp ≤ 3584)
    (h2816 : 2816 ≤ rp) :
    Reach (callState s 20497 (REPw :: wd rp :: wd ret :: tail) M)
      (callState s 22444 (REPw :: wd rp :: wd ret :: tail) (iterMem M rp)) 4035 := by
  have h1 := round1 (ret := ret) hs htl hsz hrp (A1 M) (fun _ _ => rfl) _ rfl
  have hA2 : ∀ j, j < 25 → UInt256.ofNat (word (mem1 M rp) (1024 + 32 * j)) =
      roundW (A1 M) (UInt256.ofNat (word M rp)) j := fun j hj => by
    unfold mem1
    rw [word_storeWords (toNat_lt256 _) 25 hj, ofNat_toNat]
  have hrc2 : UInt256.ofNat (word (mem1 M rp) (32 + rp)) = UInt256.ofNat (word M (32 + rp)) := by
    unfold mem1; rw [frame_storeWords25 (by omega)]
  have h2 := round2 (ret := ret) hs htl hsz hrp _ hA2 _ hrc2
  have hA3 : ∀ j, j < 25 → UInt256.ofNat (word (mem2 M rp) (91904 + 32 * j)) = W2 M rp j :=
    fun j hj => by
      unfold mem2
      rw [word_storeWords (toNat_lt256 _) 25 hj, ofNat_toNat]
  have hrc3 : UInt256.ofNat (word (mem2 M rp) (64 + rp)) = UInt256.ofNat (word M (64 + rp)) := by
    unfold mem2 mem1; rw [frame_storeWords25 (by omega), frame_storeWords25 (by omega)]
  have h3 := round3 (ret := ret) hs htl hsz hrp _ hA3 _ hrc3
  exact ((h1.trans h2).trans h3).mono (by norm_num)

/-! ## One iteration: function -/

theorem win_KS {M : ByteArray} {T : Array UInt64} (hK : KS1 M T) {j : Nat} (hj : j < 25) :
    WinU 0 256 (A1 M j) (cplU j T[j]!) := by
  have h := hK j hj
  unfold A1
  rw [show KS = 0 from rfl] at h
  rw [h, show laneOf T j = (T[j]!).toNat from rfl, ← cplU_toNat]
  exact win_rep _

theorem win_RC {M : ByteArray} (hrc : RC1Table M) {i : Nat} (hi : i < 24) :
    WinU 0 256 (UInt256.ofNat (word M (2816 + 32 * i))) Crypto.Keccak.RC[i]! := by
  rw [show 2816 + 32 * i = RC1 + 32 * i from rfl, hrc i hi]
  exact win_rep _

/-- Round with the word model, on stored lanes. -/
theorem round_step {l : Nat} {A : Nat → UInt256} {T : Array UInt64}
    (hT : T.size = 25) (hA : ∀ j, j < 25 → WinU l 256 (A j) (cplU j T[j]!)) {rc : UInt256}
    {rcl : UInt64} (hrc : WinU 0 256 rc rcl) {j : Nat} (hj : j < 25) :
    WinU (l + 63) 256 (roundW A rc j) (cplU j (Crypto.Keccak.round T rcl)[j]!) := by
  have w := win_round (s := fun i => cplU i T[i]!) hA hrc hj
  have e := roundL_cpl (fun i => T[i]!) rcl hj
  rw [e, ← round_get T hT rcl hj] at w
  exact w

theorem iterMem_frame (M : ByteArray) (rp : Nat) :
    FrameExcept M (iterMem M rp) [(KS, KS + 800), (KB, KB + 800), (KZ, KZ + 800)] := by
  have hf : FrameExcept M (iterMem M rp)
      ([(1024, 1024 + 32 * 25)] ++ [(91904, 91904 + 32 * 25)] ++ [(0, 0 + 32 * 25)]) :=
    FrameExcept.trans (FrameExcept.trans (FrameExcept.storeWords _ _ _ 25)
      (FrameExcept.storeWords _ _ _ 25)) (FrameExcept.storeWords _ _ _ 25)
  refine FrameExcept.mono hf ?_
  intro r hr
  simp only [List.cons_append, List.nil_append, List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with rfl | rfl | rfl
  · exact ⟨(KB, KB + 800), by simp, by simp [KB], by simp [KB]⟩
  · exact ⟨(KZ, KZ + 800), by simp, by simp [KZ], by simp [KZ]⟩
  · exact ⟨(KS, KS + 800), by simp, by simp [KS], by simp [KS]⟩

theorem memIter_frame (m : ByteArray) :
    ∀ i, FrameExcept m (memIter m i) [(KS, KS + 800), (KB, KB + 800), (KZ, KZ + 800)]
  | 0 => FrameExcept.refl _ _
  | i + 1 => FrameExcept.mono (FrameExcept.trans (memIter_frame m i) (iterMem_frame _ _))
      fun r hr => ⟨r, by simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hr ⊢; tauto,
        le_rfl, le_rfl⟩

theorem iter_spec {M : ByteArray} {T : Array UInt64} (hT : T.size = 25) (hK : KS1 M T)
    (hrc : RC1Table M) {i : Nat} (hi : i < 8) :
    KS1 (iterMem M (2816 + 96 * i))
        (Crypto.Keccak.round (Crypto.Keccak.round (Crypto.Keccak.round T Crypto.Keccak.RC[3 * i]!)
          Crypto.Keccak.RC[3 * i + 1]!) Crypto.Keccak.RC[3 * i + 2]!) ∧
      RC1Table (iterMem M (2816 + 96 * i)) ∧
      FrameExcept M (iterMem M (2816 + 96 * i))
        [(KS, KS + 800), (KB, KB + 800), (KZ, KZ + 800)] := by
  have hrc1 : WinU 0 256 (UInt256.ofNat (word M (2816 + 96 * i))) Crypto.Keccak.RC[3 * i]! := by
    have := win_RC hrc (i := 3 * i) (by omega)
    rwa [show 2816 + 32 * (3 * i) = 2816 + 96 * i by ring] at this
  have hrc2 : WinU 0 256 (UInt256.ofNat (word M (32 + (2816 + 96 * i))))
      Crypto.Keccak.RC[3 * i + 1]! := by
    have := win_RC hrc (i := 3 * i + 1) (by omega)
    rwa [show 2816 + 32 * (3 * i + 1) = 32 + (2816 + 96 * i) by ring] at this
  have hrc3 : WinU 0 256 (UInt256.ofNat (word M (64 + (2816 + 96 * i))))
      Crypto.Keccak.RC[3 * i + 2]! := by
    have := win_RC hrc (i := 3 * i + 2) (by omega)
    rwa [show 2816 + 32 * (3 * i + 2) = 64 + (2816 + 96 * i) by ring] at this
  have hT1 := round_size T Crypto.Keccak.RC[3 * i]! hT
  have hT2 := round_size _ Crypto.Keccak.RC[3 * i + 1]! hT1
  have w1 : ∀ j, j < 25 → WinU (0 + 63) 256
      (roundW (A1 M) (UInt256.ofNat (word M (2816 + 96 * i))) j)
      (cplU j (Crypto.Keccak.round T Crypto.Keccak.RC[3 * i]!)[j]!) := fun j hj =>
    round_step hT (fun j hj => win_KS hK hj) hrc1 hj
  have w2 : ∀ j, j < 25 → WinU (0 + 63 + 63) 256 (W2 M (2816 + 96 * i) j) _ := fun j hj =>
    round_step hT1 w1 hrc2 hj
  have w3 := fun j (hj : j < 25) => round_step hT2 w2 hrc3 hj
  have hf : FrameExcept M (iterMem M (2816 + 96 * i))
      ([(1024, 1024 + 32 * 25)] ++ [(91904, 91904 + 32 * 25)] ++ [(0, 0 + 32 * 25)]) :=
    FrameExcept.trans (FrameExcept.trans (FrameExcept.storeWords _ _ _ 25)
      (FrameExcept.storeWords _ _ _ 25)) (FrameExcept.storeWords _ _ _ 25)
  refine ⟨fun x hx => ?_, fun k hk => ?_, iterMem_frame M _⟩
  · unfold iterMem
    rw [show KS = 0 from rfl, word_storeWords (toNat_lt256 _) 25 hx,
      rerep_toNat (w3 x hx) (by norm_num), cplU_toNat]
    rfl
  · rw [FrameExcept.word hf (by
      simp only [List.cons_append, List.nil_append, avoids_cons, avoids_nil, and_true, RC1]; omega)]
    exact hrc k hk

theorem memIter_spec {m : ByteArray} {S : Array UInt64} (hS : S.size = 25) (hK : KS1 m S)
    (hrc : RC1Table m) :
    ∀ i, i ≤ 8 → KS1 (memIter m i) (rounds S (3 * i)) ∧ (rounds S (3 * i)).size = 25 ∧
      RC1Table (memIter m i)
  | 0, _ => ⟨hK, hS, hrc⟩
  | i + 1, hi => by
    obtain ⟨hK', hS', hrc'⟩ := memIter_spec hS hK hrc i (by omega)
    obtain ⟨hK'', hrc'', -⟩ := iter_spec hS' hK' hrc' (i := i) (by omega)
    rw [show 3 * (i + 1) = 3 * i + 3 by ring, rounds_three]
    exact ⟨hK'', round_size _ _ (round_size _ _ (round_size _ _ hS')), hrc''⟩

/-! ## The call -/

theorem kf1_reach {s : State} (hs : Ctx s) {ret : Nat} {tail : List UInt256}
    (hr : RetOK Stack.kf1 ret tail) (m : ByteArray) :
    Call s Entry.kf1 [] ret tail m [] (memIter m 8) Gas.kf1 := by
  have htl : tail.length ≤ 960 := by
    have := hr.depth; simp only [Stack.kf1, Stack.leaf] at this; omega
  have hsz : 2897 ≤ s.activeWords.toNat := hs.sized
  let I : Nat → State := fun i =>
    callState s 20497 (REPw :: wd (2816 + 96 * i) :: wd ret :: tail) (memIter m i)
  have hbody : ∀ i, i < 7 → Reach (I i) (I (i + 1)) 4069 := by
    intro i hi
    have h := (iter_reach hs htl hsz (M := memIter m i) (rp := 2816 + 96 * i) (ret := ret)
      (by omega) (by omega)).trans
      (loopBack hs htl hsz (M := iterMem (memIter m i) (2816 + 96 * i)) (by omega) (by omega))
    refine (h.mono (by norm_num)).of_eq rfl ?_
    simp only [I, memIter]
    rw [show 96 + (2816 + 96 * i) = 2816 + 96 * (i + 1) by ring]
  have hlast := (iter_reach hs htl hsz (M := memIter m 7) (rp := 2816 + 96 * 7) (ret := ret)
    (by norm_num) (by norm_num)).trans
    (loopExit hs htl hsz (by norm_num) (by norm_num) hr.small hr.jumpdest)
  have h := ((prologue hs htl hsz m ret).trans (Reach.loop (I := I) 7 hbody)).trans hlast
  rw [call_iff]
  exact (h.mono (by norm_num [Gas.kf1])).of_eq rfl rfl

theorem kf1_main {s : State} (hs : Ctx s) {ret : Nat} {tail : List UInt256}
    (hr : RetOK Stack.kf1 ret tail) (m : ByteArray) (hrc : RC1Table m) :
    ∃ m', (∀ S : Fips202.SpongeState, S.size = 25 → KS1 m S →
        KS1 m' (EvmSemantics.Crypto.Keccak.permute S)) ∧
      FrameExcept m m' [(KS, KS + 800), (KB, KB + 800), (KZ, KZ + 800)] ∧
      Call s Entry.kf1 [] ret tail m [] m' Gas.kf1 := by
  refine ⟨memIter m 8, fun S hS hK => ?_, memIter_frame m 8, kf1_reach hs hr m⟩
  rw [permute_eq]
  exact (memIter_spec hS hK hrc 8 le_rfl).1

