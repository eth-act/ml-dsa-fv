import MlDsaOpt87.Layout
import MlDsaOpt87.Budget
import MlDsaOpt87.Fn.Kf4.Main
import MlDsaOpt87.Fn.Kf1.Main
/- The ML-DSA-44 contracts at this artifact (`kf4`, `kf1`: ported by `scripts/proofgen_port.py 87`; the `kf1` command is in the header of `Fn/Kf1/*.lean`). -/
set_option maxHeartbeats 0  -- port: re-elaboration headroom
/-!
# `kf4` and `kf1`: Keccak-f[1600] (work packages WP1, WP2)

Generated by `scripts/opt_keccak.py` (`gen_keccak_f`).

* `kf4`: four states bit-interleaved (`KS4`), 12 loop iterations of two
  straight-line rounds between `KS` and `KB`, iota from `RC4`; a 64-bit
  rotation of every slot is a 256-bit rotation by `4n`.
* `kf1`: one state replicated in all lanes (`KS1`), 8 loop iterations of three
  straight-line rounds `KS → KB → KZ → KS`, iota from `RC1`; rotations are
  single left shifts (decaying window, offset −1), the third round of each
  iteration re-replicates bits `[192, 256)` (`(w >> 192) · REP`).

Both keep lanes `complemented` inverted (lane-complementing chi, `CHI`).
Entry stack `[ret]`, no results; `KB` (and for `kf1` `KZ`) is scratch.
-/

namespace MlDsaOpt87.Proofs

open MlDsaOpt44.Proofs

open EvmSemantics
open EvmSemantics.EVM
open MlDsaOptCommon
open MlDsa44

/-- **kf4**: Keccak-f on each of the four interleaved states in `KS`. -/
theorem kf4_call {s : State} (hs : Ctx s) {ret : Nat} {tail : List UInt256}
    (hr : RetOK Stack.kf4 ret tail) (m : ByteArray) (hrc : RC4Table m) :
    ∃ m', (∀ S, Sized4 S → KS4 m S →
        KS4 m' fun k => EvmSemantics.Crypto.Keccak.permute (S k)) ∧
      FrameExcept m m' [(KS, KS + 800), (KB, KB + 800)] ∧
      Call s Entry.kf4 [] ret tail m [] m' Gas.kf4 :=
  Kf4.kf4_spec hs hr m hrc

/-- **kf1**: Keccak-f on the replicated state in `KS`. -/
theorem kf1_call {s : State} (hs : Ctx s) {ret : Nat} {tail : List UInt256}
    (hr : RetOK Stack.kf1 ret tail) (m : ByteArray) (hrc : RC1Table m) :
    ∃ m', (∀ S : Fips202.SpongeState, S.size = 25 → KS1 m S →
        KS1 m' (EvmSemantics.Crypto.Keccak.permute S)) ∧
      FrameExcept m m' [(KS, KS + 800), (KB, KB + 800), (KZ, KZ + 800)] ∧
      Call s Entry.kf1 [] ret tail m [] m' Gas.kf1 :=
  Kf1.kf1_main hs hr m hrc

end MlDsaOpt87.Proofs
