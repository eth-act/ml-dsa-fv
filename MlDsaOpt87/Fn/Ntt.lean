import MlDsaOpt87.Layout
import MlDsaOpt87.Budget
import MlDsa.Bridge44
import MlDsaOpt87.Fn.NttV4.Top
/-!
# Four-lane NTT and inverse NTT (ML-DSA-87)

The kernels are byte-identical to ML-DSA-44 up to jump targets, except that the
inverse NTT stores its outputs (UseHint stays the separate `usehint`, `Fn/Hint.lean`)
(`MlDsaOpt44/Fn/Ntt.lean` explains the algorithm and the bounds). The v4 proof is
`Fn/NttV4/` (generated by `MlDsaOpt65/Fn/NttV4/gen_ntt4p.py 87`), with the
polynomial address `P` a parameter of every lemma, so one development covers both
call sites; the parameter-free lemmas are the ML-DSA-44 ones
(`MlDsaOpt44/Fn/Ntt/V4/`), the `γ1 = 2^19` ones are shared with ML-DSA-65
(`MlDsaOpt65/Fn/NttV4/{Arith,Lemmas}.lean`).

The contracts below take the address `p` as an argument restricted to the call sites
of `MlDsaOpt/87/opt.asm`: `ntt` at `ZH` and `ZH2`, `intt` at `ACC` and `ACC + 0x2000`.
They are stated against the parametric `MlDsa.Fips204.ntt` / `nttInv` (equal to the
ML-DSA-44 ones by `MlDsa/Bridge44.lean`).

(`Fn/Ntt/*`, `Fn/Ntt2/*` are the v3 proofs, outside the v4 import graph.)
-/

namespace MlDsaOpt87.Proofs

open EvmSemantics
open EvmSemantics.EVM
open MlDsaOptCommon
open MlDsa

/-- **ntt**: `[p, ret]` with `p ∈ {ZH, ZH2}`, in place on the four lane polynomials at `p`. -/
theorem ntt_call {s : State} (hs : Ctx s) {p : Nat} (hp : p = ZH ∨ p = ZH2) {ret : Nat}
    {tail : List UInt256} (hr : RetOK Stack.ntt ret tail) (m : ByteArray) (htbl : TblAt m) :
    ∃ m', ((∀ k, k < 4 → ∀ t, t < 256 → zLo ≤ lane (word m (p + 32 * t)) k ∧
          lane (word m (p + 32 * t)) k ≤ zHi) →
        ∀ k, k < 4 → ∀ t, t < 256 → lane (word m' (p + 32 * t)) k < 2 ^ 28 ∧
          ((lane (word m' (p + 32 * t)) k : Int) - (Fips204.ntt (lanesPoly m p k))[t]!) %
            (Fips204.q : Int) = 0) ∧
      FrameExcept m m' [(p, p + 8192)] ∧
      Call s Entry.ntt [wd p] ret tail m [] m' Gas.ntt :=
  Ntt4.ntt_v4 hs hp hr m htbl

/-- **intt**: `[p, ret]` with `p ∈ {ACC, ACC + 0x2000}`, in place on the four lane
polynomials at `p` (v4: GS butterflies without swap; outputs `< 2^30`). -/
theorem intt_call {s : State} (hs : Ctx s) {p : Nat} (hp : p = ACC ∨ p = ACC + 0x2000)
    {ret : Nat} {tail : List UInt256} (hr : RetOK Stack.intt ret tail) (m : ByteArray)
    (htbl : TblAt m) :
    ∃ m', ((∀ k, k < 4 → ∀ t, t < 256 → lane (word m (p + 32 * t)) k < 2 ^ 57) →
        ∀ k, k < 4 → ∀ t, t < 256 → lane (word m' (p + 32 * t)) k < 2 ^ 30 ∧
          ((lane (word m' (p + 32 * t)) k : Int) - (Fips204.nttInv (lanesPoly m p k))[t]!) %
            (Fips204.q : Int) = 0) ∧
      FrameExcept m m' [(p, p + 8192)] ∧
      Call s Entry.intt [wd p] ret tail m [] m' Gas.intt :=
  Ntt4.intt_v4 hs hp hr m htbl

end MlDsaOpt87.Proofs
