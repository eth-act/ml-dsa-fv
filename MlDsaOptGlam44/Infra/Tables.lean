open MlDsaOptGlam44.Proofs.Artifact

/-- Byte size of an instruction, without encoding it. -/
def isz : XInstr → Nat
  | .base (.push w _) => 1 + w.val
  | .base (.op _) => 1
  | _ => 2

theorem bytes_length_eq_isz (i : XInstr) : i.bytes.length = isz i := by
  cases i with
  | base i => cases i <;> simp [isz, XInstr.bytes]
  | _ => simp [isz, XInstr.bytes]

theorem assembleBytes_length (l : List XInstr) :
    (xassembleBytes l).length = (l.map isz).sum := by
  induction l with
  | nil => rfl
  | cons i l ih => simp [ih, bytes_length_eq_isz]

/-- Byte offset of instruction `n`. -/
def pcOf (n : Nat) : Nat := ((instructionList.take n).map isz).sum

theorem instructionPC_eq_pcOf (n : Nat) :
    artifact.instructionPC n = pcOf n := by
  unfold EvmProof.XArtifact.instructionPC pcOf
  exact assembleBytes_length _

/-! ## Lookup trees -/

/-- A binary lookup tree; `get` reads index bits from least significant. -/
inductive BTree (α : Type) where
  | leaf (a : Option α)
  | node (l r : BTree α)

def BTree.get {α : Type} : BTree α → Nat → Option α
  | .leaf a, _ => a
  | .node l r, i => if i % 2 = 0 then l.get (i / 2) else r.get (i / 2)

/-- Boolean instruction equality (`XInstr` has no `DecidableEq`). -/
def instrBEq : XInstr → XInstr → Bool
  | .base (.push w v), .base (.push w' v') => decide (w = w') && decide (v = v')
  | .base (.op o), .base (.op o') => decide (o = o')
  | .dupN x, .dupN x' => decide (x = x')
  | .swapN x, .swapN x' => decide (x = x')
  | .exchange x, .exchange x' => decide (x = x')
  | _, _ => false

theorem eq_of_instrBEq {a b : XInstr} (h : instrBEq a b = true) : a = b := by
  cases a with
  | base i => cases i <;> cases b <;> (try rename_i j; try cases j) <;> simp_all [instrBEq]
  | _ => cases b <;> (try rename_i j; try cases j) <;> simp_all [instrBEq]

def optInstrBEq : Option XInstr → XInstr → Bool
  | some a, b => instrBEq a b
  | none, _ => false

theorem eq_of_optInstrBEq {a : Option XInstr} {b : XInstr}
    (h : optInstrBEq a b = true) : a = some b := by
  cases a with
  | none => cases h
  | some a => rw [eq_of_instrBEq h]

/-- One linear pass checking both trees from index `k`, offset `pc`. -/
def checkAll (t : BTree XInstr) (p : BTree Nat) : Nat → Nat → List XInstr → Bool
  | k, pc, [] => p.get k == some pc
  | k, pc, i :: is =>
      optInstrBEq (t.get k) i && p.get k == some pc && checkAll t p (k + 1) (pc + isz i) is

theorem checkAll_spec (t : BTree XInstr) (p : BTree Nat) :
    ∀ (l : List XInstr) (k pc : Nat), checkAll t p k pc l = true →
      (∀ j, j < l.length → t.get (k + j) = l[j]?) ∧
      (∀ j, j ≤ l.length → p.get (k + j) = some (pc + ((l.take j).map isz).sum)) := by
  intro l
  induction l with
  | nil =>
    intro k pc h
    simp only [checkAll, beq_iff_eq] at h
    refine ⟨fun j hj => by simp at hj, fun j hj => ?_⟩
    simp at hj; subst hj; simpa using h
  | cons i is ih =>
    intro k pc h
    simp only [checkAll, Bool.and_eq_true, beq_iff_eq] at h
    obtain ⟨⟨hi, hp⟩, hrest⟩ := h
    obtain ⟨ih1, ih2⟩ := ih (k + 1) (pc + isz i) hrest
    refine ⟨fun j hj => ?_, fun j hj => ?_⟩
    · cases j with
      | zero => simpa using eq_of_optInstrBEq hi
      | succ j =>
        have := ih1 j (by simpa using hj)
        rw [show k + (j + 1) = k + 1 + j by omega, this]
        simp
    · cases j with
      | zero => simpa using hp
      | succ j =>
        have := ih2 j (by simpa using hj)
        rw [show k + (j + 1) = k + 1 + j by omega, this]
        simp [Nat.add_assoc]

/-! ## Meta-level view of the instruction list -/

section Meta
open Lean Meta Elab Command

/-- The instruction `Expr`s of `instructionList`, in order (uncached). -/
def instrExprsRaw : MetaM (Array Expr) := do
  let mut out := #[]
  for k in [0:87] do
    let name := Name.mkStr `MlDsaOptGlam44.Proofs.Artifact s!"instructions{k}"
    let some v := (← getEnv).find? name |>.bind (·.value?) | throwError "missing {name}"
    let mut e := v
    -- Long list literals are elaborated as `have y := tail; a :: … :: y`.
    repeat
      if let .letE _ _ val body _ := e then
        e := body.instantiate1 val
      else if e.isAppOfArity ``List.cons 3 then
        out := out.push (e.getArg! 1)
        e := e.getArg! 2
      else break
  return out

/-- Byte size of an instruction `Expr` (`XInstr.base (Instr.push w v)`, …). -/
def instrExprSize (e : Expr) : MetaM Nat := do
  unless e.isAppOfArity ``XInstr.base 1 do return 2
  let e := e.getArg! 0
  if e.isAppOfArity ``Instr.push 2 then
    let w := e.getArg! 0
    let some (n : Nat) := (← getFinValue? w).map (fun v => v.2.val)
      | throwError "unexpected push width {w}"
    return 1 + n
  return 1

/-- Byte offsets of all instructions plus the end offset (uncached). -/
def pcValuesOf (instrs : Array Expr) : MetaM (Array Nat) := do
  let mut out := #[0]
  let mut pc := 0
  for i in instrs do
    pc := pc + (← instrExprSize i)
    out := out.push pc
  return out

/-- Build the bit-interleaved tree literal over `elems`. -/
partial def treeExpr (ty : Expr) (elems : Array Expr) : Expr :=
  if elems.size ≤ 1 then
    mkApp2 (mkConst ``BTree.leaf) ty <| match elems[0]? with
      | some e => mkApp2 (mkConst ``Option.some [0]) ty e
      | none => mkApp (mkConst ``Option.none [0]) ty
  else
    let evens := (List.range ((elems.size + 1) / 2)).toArray.map (fun i => elems[2 * i]!)
    let odds := (List.range (elems.size / 2)).toArray.map (fun i => elems[2 * i + 1]!)
    mkApp3 (mkConst ``BTree.node) ty (treeExpr ty evens) (treeExpr ty odds)

elab "define_tables" : command => liftTermElabM do
  let instrTy := mkConst ``XInstr
  let instrs ← instrExprsRaw
  let pcs ← pcValuesOf instrs
  for (name, ty, elems) in [(`MlDsaOptGlam44.Proofs.Infra.instrTree, instrTy, instrs),
      (`MlDsaOptGlam44.Proofs.Infra.pcTree, mkConst ``Nat, pcs.map mkNatLit)] do
    addDecl <| .defnDecl {
      name, levelParams := [], type := mkApp (mkConst ``BTree) ty
      value := treeExpr ty elems, hints := .opaque, safety := .safe }

end Meta

define_tables

theorem checkAll_append (t : BTree XInstr) (p : BTree Nat) (l₁ l₂ : List XInstr) (k pc : Nat)
    (h₁ : checkAll t p k pc l₁ = true)
    (h₂ : checkAll t p (k + l₁.length) (pc + (l₁.map isz).sum) l₂ = true) :
    checkAll t p k pc (l₁ ++ l₂) = true := by
  induction l₁ generalizing k pc with
  | nil => simpa using h₂
  | cons i is ih =>
    have e1 : k + (i :: is).length = k + 1 + is.length := by
      simp only [List.length_cons]; omega
    have e2 : pc + ((i :: is).map isz).sum = pc + isz i + (is.map isz).sum := by
      simp only [List.map_cons, List.sum_cons]; omega
    rw [e1, e2] at h₂
    simp only [List.cons_append, checkAll, Bool.and_eq_true] at h₁ ⊢
    exact ⟨h₁.1, ih (k + 1) (pc + isz i) h₁.2 h₂⟩

/-- JUMPDEST test (here, after `instrBEq`, so its `match` shares that
function's sparse-cases auxiliary exactly as in a single module). -/
def isJumpdest : XInstr → Bool
  | .base (.op .JUMPDEST) => true
  | _ => false

theorem eq_of_isJumpdest {i : XInstr} (h : isJumpdest i = true) :
    i = .base (.op .JUMPDEST) := by
  unfold isJumpdest at h
  split at h
  · rfl
  · cases h

