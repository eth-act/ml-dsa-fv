/-- Run `l` on `s` if `s` is still running. -/
def runIfRunning {artifact : EvmProof.XArtifact} {fork : Fork}
    (s : State) (l : XLocated artifact fork) : Option State :=
  match s.halt with
  | .Running => runXLocated l s
  | _ => none

/-- One fold step: run `l` if the state is still running. -/
def stepL {artifact : EvmProof.XArtifact} {fork : Fork}
    (acc : Option State) (l : XLocated artifact fork) : Option State :=
  acc.bind fun s => runIfRunning s l

theorem stepL_some {artifact : EvmProof.XArtifact} {fork : Fork}
    (s : State) (l : XLocated artifact fork) :
    stepL (some s) l = runIfRunning s l := rfl

theorem stepL_none {artifact : EvmProof.XArtifact} {fork : Fork}
    (l : XLocated artifact fork) : stepL none l = none := rfl

/-- Not a `rfl` lemma on purpose: the kernel must not re-check it by
evaluating `runXLocated` (and with it `instructionPC`). -/
theorem runIfRunning_of {artifact : EvmProof.XArtifact} {fork : Fork}
    {s : State} (l : XLocated artifact fork) (h : s.halt = .Running) :
    runIfRunning s l = runXLocated l s := by
  unfold runIfRunning; rw [h]

theorem foldl_stepL_none {artifact : EvmProof.XArtifact} {fork : Fork}
    (path : List (XLocated artifact fork)) : path.foldl stepL none = none := by
  induction path with
  | nil => rfl
  | cons l rest ih => simpa [List.foldl_cons, stepL_none] using ih

theorem runXLocatedBlock_eq_foldl {artifact : EvmProof.XArtifact} {fork : Fork}
    (path : List (XLocated artifact fork)) (s : State) (h : s.halt = .Running) :
    runXLocatedBlock path s = path.foldl stepL (some s) := by
  induction path generalizing s with
  | nil => rfl
  | cons l rest ih =>
    simp only [List.foldl_cons, stepL_some, runIfRunning_of l h]
    cases hl : runXLocated l s with
    | none => simp [runXLocatedBlock, hl, foldl_stepL_none]
    | some t =>
      cases rest with
      | nil => simp [runXLocatedBlock, hl]
      | cons x r =>
        have hstep : (x :: r).foldl stepL (some t) = (x :: r).foldl stepL
            (match t.halt with | .Running => some t | _ => none) := by
          cases ht : t.halt <;> simp [List.foldl_cons, stepL_some, stepL_none, runIfRunning, ht, foldl_stepL_none]
        rw [hstep]
        cases ht : t.halt with
        | Running => rw [← ih t ht]; simp [runXLocatedBlock, hl, ht]
        | _ => simp [runXLocatedBlock, hl, ht, stepL_none, foldl_stepL_none]

/-- Pass `o` through iff the halt flag is `Running`. -/
def guardHalt (h : HaltKind) (o : Option State) : Option State :=
  match h with
  | .Running => o
  | _ => none

theorem guardHalt_running (o : Option State) : guardHalt .Running o = o := rfl

/-- The step lemma used by `glam44_block`: one fold step at instruction `i`,
with instruction and offset read from the lookup trees. -/
theorem stepL_located (i : Fin 34532) (st : State) :
    stepL (some st) (located i) =
      guardHalt st.halt
        (if st.pc.toNat = pcAt i.val then runXInstr (instrAt i.val) st else none) := by
  rw [stepL_some, runIfRunning, EvmProof.Stepper.runXLocated,
    located_instruction_eq, located_index_eq,
    instructionPC_eq_pcAt (by have := i.isLt; omega)]
  rfl

/-- `PUSH0` pushes the literal word `⟨0⟩`; normalize it to `UInt256.ofNat 0`. -/
theorem push0_eq : ({ val := 0 } : UInt256) = UInt256.ofNat 0 := rfl

open Lean Meta Simp in
/-- `Fin.val` of a `Fin` literal ↦ the `Nat` literal (push widths, DUP/SWAP
indices). -/
dsimproc_decl finVal_lit (Fin.val _) := fun e => do
  unless e.isAppOfArity ``Fin.val 2 do return .continue
  let some v ← getFinValue? (e.getArg! 1) | return .continue
  return .done (mkNatLit v.2.val)

