  simp only [gL23, ch43, bv, bv0, Ops256_xor, Ops256_and, Ops256_or, Ops256_not, Ops256_rot, u256_xor_comm, u256_land_comm, u256_lor_comm]

theorem gL23_eq (c : Fin 25 → UInt256) (rc : UInt256) :
    gL23 Ops256 c (gD0 Ops256 c) (gD1 Ops256 c) (gD2 Ops256 c) (gD3 Ops256 c) (gD4 Ops256 c) rc = out43 Ops256 c rc := by
  simp only [gL23_shape, gD0_eq, gD1_eq, gD2_eq, gD3_eq, gD4_eq, out43]

theorem gL24_shape (c : Fin 25 → UInt256) (d0 d1 d2 d3 d4 rc : UInt256) :
    gL24 Ops256 c d0 d1 d2 d3 d4 rc = ch44 Ops256 (bv Ops256 d1 (c 21) 2) (bv Ops256 d2 (c 2) 62) (bv Ops256 d3 (c 8) 55) := by
  simp only [gL24, ch44, bv, bv0, Ops256_xor, Ops256_and, Ops256_or, Ops256_not, Ops256_rot, u256_xor_comm, u256_land_comm, u256_lor_comm]

theorem gL24_eq (c : Fin 25 → UInt256) (rc : UInt256) :
    gL24 Ops256 c (gD0 Ops256 c) (gD1 Ops256 c) (gD2 Ops256 c) (gD3 Ops256 c) (gD4 Ops256 c) rc = out44 Ops256 c rc := by
  simp only [gL24_shape, gD0_eq, gD1_eq, gD2_eq, gD3_eq, gD4_eq, out44]

end MlDsaOptGlam44.Proofs.Kf4
