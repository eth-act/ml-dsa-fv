  exact ⟨M2, hP2, frame_trans1 hF1 hF2,
    ((hR1.trans hR2).trans (fwA_exit hs htail M2 ret P (by omega) (P + 32 * 15) (by omega))).mono
      (by simp only [costSum]; norm_num)⟩

