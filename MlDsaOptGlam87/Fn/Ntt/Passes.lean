      obtain ⟨M', hP', hF', hR'⟩ := fwA_body hs htail ret P hPv H h c (by omega) M hQ.1
      exact ⟨M', ⟨hP', frame_trans1 hQ.2 hF'⟩,
        reach_post1 (hR'.trans (fwA_cont hs htail M' ret P (by omega) (P + 32 * c) (by omega)))
