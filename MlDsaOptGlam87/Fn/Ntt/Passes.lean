        (callState s 24048 (UInt256.ofNat P :: UInt256.ofNat 4096 :: cM :: UInt256.ofNat P :: UInt256.ofNat ret :: tail) M') 38682 := by
  obtain ⟨M1, ⟨hP1, hF1⟩, hR1⟩ := reach_iterF
    (S := fun c M => callState s 22854 (UInt256.ofNat (P + 32 * c) :: UInt256.ofNat (P + 512) :: cM :: UInt256.ofNat P :: UInt256.ofNat ret :: tail) M)
    (Q := fun c M => (H → PI M P (fun t => t % 16 < c) (FP h 0) (FP h 4)) ∧
      FrameExcept M0 M [(P, P + 8192)])
