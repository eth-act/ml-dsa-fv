    (S := fun n M => callState s 24048 (UInt256.ofNat (P + 512 * n) :: UInt256.ofNat (4096 + 480 * n) :: cM :: UInt256.ofNat P :: UInt256.ofNat ret :: tail) M)
    (Q := fun n M => (H → PI M P (fun t => t / 16 < n) (FP h 4) (FP h 8)) ∧
      FrameExcept M0 M [(P, P + 8192)])
    (c := fun _ => 2689 + 40) 15 (fun n M hn hQ => by
      obtain ⟨M', hP', hF', hR'⟩ := fwB_body hs htail ret P hPv H h n (by omega) M
