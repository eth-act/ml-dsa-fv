set_option warningAsError true
/-! Generated by `scripts/proofgen_artifact_glam.py`; do not edit.

# Blocks, calls and copies of this artifact as `Reach` facts

* `reach_block`: a straight-line block between two `callState s …` states
  costs exactly its static opcode sum `blockCost path` (memory never grows:
  both ends share `s.activeWords`).
* `reach_block_pot`: any straight-line block from a `Ctx0` state (memory may
  grow, the last instruction may halt): static sum plus memory-potential growth.
* `RetOK.callee`: discharge a callee's `RetOK` at a call site.
* `glam87_reach path [with lemmas]`: `reach_block` + `glam87_block`.
-/

namespace MlDsaOptGlam87.Proofs.Infra

open EvmSemantics
open EvmSemantics.EVM
open EvmProof.Stepper
open MlDsaOptCommon
open MlDsaOptGlam87.Proofs.Artifact

/-- Static (memory-free) cost of a path, from the lookup trees. -/
noncomputable def blockCost (path : List (Fin 34160)) : Nat :=
  (path.map fun i => EvmProof.Meter.xinstrStaticCost .Amsterdam (instrAt i.val)).sum

/-- Kernel-checkable side condition of `reach_block` (`by decide +kernel`). -/
noncomputable def blockOK (path : List (Fin 34160)) (cost : Nat) : Bool :=
  path.all (fun i => EvmProof.Meter.XCopyFree (instrAt i.val)) && blockCost path == cost

/-- `#eval`-able twin of `blockCost`, for finding the literal to state. -/
def blockCostEval (path : List Nat) : Nat :=
  (path.map fun i => EvmProof.Meter.xinstrStaticCost .Amsterdam
    (instructionList.getD i (.base (.op .INVALID)))).sum

theorem reach_block {s : State} (hs : Ctx s) (path : List (Fin 34160)) {cost : Nat}
    {pc pc' : Nat} {stk stk' : List UInt256} {m m' : ByteArray}
    (hok : blockOK path cost = true)
    (hrun : runXLocatedBlock (locatedPath path) (callState s pc stk m) =
      some (callState s pc' stk' m')) :
    Reach (callState s pc stk m) (callState s pc' stk' m') cost := by
  simp only [blockOK, Bool.and_eq_true, List.all_eq_true, beq_iff_eq] at hok
  obtain ⟨hfree, hcost⟩ := hok
  have hcode : (callState s pc stk m).executionEnv.code = artifact.code := hs.code
  have hfork : (callState s pc stk m).fork = .Amsterdam := hs.fork
  have hrunning : (callState s pc stk m).halt = .Running := hs.running
  have hnp := hs.notPrecompile
  let g := runXLocatedBlock_sound artifact .Amsterdam (locatedPath path) hcode hfork hrun
    hrunning hnp
  refine ⟨g, le_of_eq ?_⟩
  have hpot := EvmProof.Meter.runXLocatedBlock_cost_potential_of_copyFree (locatedPath path)
    (blockCost path) hrun hfork ?free ?static
  · change runXLocatedBlockCost (locatedPath path) (callState s pc stk m) = cost
    change _ + MachineState.memCost s.activeWords.toNat =
      _ + MachineState.memCost s.activeWords.toNat at hpot
    omega
  case free =>
    intro l hl
    simp only [locatedPath, List.mem_map] at hl
    obtain ⟨i, hi, rfl⟩ := hl
    rw [located_instruction_eq]
    exact hfree i hi
  case static =>
    unfold EvmProof.Meter.runXLocatedBlockStaticCost blockCost locatedPath
    simp only [List.map_map]
    congr 1
    apply List.map_congr_left
    intro i _
    simp only [Function.comp, located_instruction_eq]

theorem reach_block_pot {s t : State} (h0 : Ctx0 s) (path : List (Fin 34160)) {cost : Nat}
    (hok : blockOK path cost = true)
    (hrun : runXLocatedBlock (locatedPath path) s = some t) :
    Reach s t (cost + MachineState.memCost t.activeWords.toNat -
      MachineState.memCost s.activeWords.toNat) := by
  simp only [blockOK, Bool.and_eq_true, List.all_eq_true, beq_iff_eq] at hok
  obtain ⟨hfree, hcost⟩ := hok
  have hcode : s.executionEnv.code = artifact.code := h0.code
  let g := runXLocatedBlock_sound artifact .Amsterdam (locatedPath path) hcode h0.fork hrun
    h0.running h0.notPrecompile
  refine ⟨g, le_of_eq ?_⟩
  have hpot := EvmProof.Meter.runXLocatedBlock_cost_potential_of_copyFree (locatedPath path)
    (blockCost path) hrun h0.fork ?free ?static
  · change runXLocatedBlockCost (locatedPath path) s = _
    omega
  case free =>
    intro l hl
    simp only [locatedPath, List.mem_map] at hl
    obtain ⟨i, hi, rfl⟩ := hl
    rw [located_instruction_eq]
    exact hfree i hi
  case static =>
    unfold EvmProof.Meter.runXLocatedBlockStaticCost blockCost locatedPath
    simp only [List.map_map]
    congr 1
    apply List.map_congr_left
    intro i _
    simp only [Function.comp, located_instruction_eq]

end MlDsaOptGlam87.Proofs.Infra

/-- Discharge a callee's `RetOK` at a call site. The caller holds
`hr : RetOK B ret tail`; at the call the callee's tail is `extra ++ tail`. -/
theorem MlDsaOptGlam87.Proofs.RetOK.callee {B B' ret ret' : Nat} {tail extra : List EvmSemantics.UInt256}
    (hr : MlDsaOptGlam87.Proofs.RetOK B ret tail) (hB : B' + extra.length ≤ B)
    (hj : EvmSemantics.EVM.Decode.isValidJumpDest MlDsaOptGlam87.optBytecode ret' = true)
    (hsmall : ret' < 2 ^ 16) :
    MlDsaOptGlam87.Proofs.RetOK B' ret' (extra ++ tail) :=
  ⟨hj, hsmall, by have := hr.depth; simp only [List.length_append]; omega⟩

/-- Prove `Reach (callState s pc stk m) (callState s pc' stk' m') cost` for a
straight-line path of this artifact: checks the static cost with the kernel,
then runs `glam87_block`. Needs `hs : Ctx s` in context. -/
syntax "glam87_reach " term:max (" with " "[" Lean.Parser.Tactic.simpLemma,* "]")? : tactic

macro_rules
  | `(tactic| glam87_reach $path:term) => `(tactic| glam87_reach $path with [])
  | `(tactic| glam87_reach $path:term with [$extra:simpLemma,*]) => `(tactic| (
      refine MlDsaOptGlam87.Proofs.Infra.reach_block (by assumption) $path
        (by first
          | decide +kernel
          | fail "glam87_reach: the stated cost is not the path's static cost (or the path \
              contains MCOPY/CALLDATACOPY); get it with `#eval MlDsaOptGlam87.Proofs.Infra.blockCostEval [indices]`") ?_
      glam87_block [$extra,*]))
