/-! # Segment `0 … 992`: size check, memory sizing, the `RC4`/`RC1` iota tables (straight line) -/

namespace MlDsaOptGlam87.Proofs

open MlDsaOpt87.Proofs

open EvmSemantics
open EvmSemantics.EVM
open MlDsaOptCommon
open MlDsa

/-- `0 … 992` from the frame entry (memory empty, not yet sized); proved in `Main/S1/Init.lean`.
Mirror `MlDsaOpt44/Main/SegInit.lean` + `Main/Init/*` (the code of this segment
is generated by the same `init_tables`; same instruction count, relocated by
`scripts/proofgen_port.py 87`); the entry store at `TOP − 32 = 0x16600` sizes
memory to `memWords = 2897` words (`reach_block_pot`). -/
theorem seg_init {s : State} (h0 : Ctx0 s) (haw : s.activeWords.toNat = 0)
    (hcd : HDR ≤ s.executionEnv.calldata.size) (hfit : s.executionEnv.calldata.size < 2 ^ 64) :
    ∃ m, Inv0 m ∧
      Reach (callState s 0 [] .empty) (callState (sized s) 15 [] m)
        (Gas.pInit + MachineState.memCost memWords) := by
  exact S1.seg_init_proof h0 haw hcd hfit

end MlDsaOptGlam87.Proofs
