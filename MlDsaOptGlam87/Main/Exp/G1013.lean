/-- `AND` and the `pass3f10` call after group 10's fix-up. -/
def costP10 : Nat := 18 + Gas.pass3f10

/-- The static cost of `3612 … 5394`: glue plus the calls of the four groups. -/
def gG1013 : Nat := G1013.cost10 + costP10 + G1013.cost11 + G1013.cost12 + G1013.cost13

theorem g1013_flag (cd : ByteArray) (b : Bool) :
    (((((b && okCol cd 1 3 3) && okCol cd 1 4 3)) && okCol cd 1 5 3) && okCol cd 1 6 3) = mixFlag cd b := rfl

theorem exp_g1013 {s : State} (hs : Ctx s) (hcd : HDR ≤ s.executionEnv.calldata.size) {m : ByteArray}
    (hI : MixIn s.executionEnv.calldata m) (b : Bool) :
    ∃ m', InvG14 s.executionEnv.calldata m' ∧
      Reach (callState s 2571 [flag b] m)
        (callState s 4353 [flag (mixFlag s.executionEnv.calldata b)] m') gG1013 := by
  have hI0 := hI.inv
  obtain ⟨m10, hks10, hl10, hrc10, hf10, hR10⟩ := grp10 hs hcd (b := b) hI0.rc4 hI0.rho
  -- AND, pass3f10
  have gP : Reach (callState s 2961 [flag (okCol s.executionEnv.calldata 1 3 3), flag b] m10)
      (callState s 17704 [wd 2970, flag (b && okCol s.executionEnv.calldata 1 3 3)] m10) 18 := by
    glam87_rreach [1080, 1081, 1082, 1083, 1084] with [flag, ite01_land]
  obtain ⟨mP, hwP, hfP, hcP⟩ := pass3f10_call hs (ret := 2970)
    (tail := [flag (b && okCol s.executionEnv.calldata 1 3 3)])
    (retOK_main (by decide) (by simp) (by simp only [isValidJumpDest_lit]) (by norm_num)) m10
  have hzh10 : ∀ k, k < 7 → ∀ t, t < 256 → zhLane m10 k t = zhLane m k t :=
    fun k hk t ht => zhLane_frame hf10 (by g1013_frame) (by omega) ht
  have hzhP : ∀ k, k < 7 → ∀ t, t < 256 → zhLane mP k t = zhLane m10 k t :=
    fun k hk t ht => zhLane_frame hfP (by g1013_frame) (by omega) ht
  have hzh10' : ZHatAt m10 s.executionEnv.calldata := ZHatAt.frame hI0.zhat hf10 (by g1013_frame)
  have hacc1 : Acc1 mP s.executionEnv.calldata :=
    acc1_p3f10 hzh10' (hI.c0.frame hf10 (by g1013_frame)) (hI.c1.frame hf10 (by g1013_frame))
      (hI.c2.frame hf10 (by g1013_frame)) hl10 hwP hzhP
  have hksP := KS4.frame hks10 hfP (by g1013_frame)
  have hfA := FrameExcept.trans hf10 hfP
  obtain ⟨m11, hks11, hl11, hrc11, hf11, hR11⟩ := grp11 hs hcd (b := b && okCol s.executionEnv.calldata 1 3 3)
    (RC4Table.frame hrc10 hfP (by g1013_frame)) (Rho1At.frame hI0.rho hfA (by g1013_frame)) hksP
  have hfB := FrameExcept.trans hfA hf11
  obtain ⟨m12, hks12, hl12, hrc12, hf12, hR12⟩ := grp12 hs hcd hrc11 (Rho1At.frame hI0.rho hfB (by g1013_frame))
    hks11
  have hfC := FrameExcept.trans hfB hf12
  obtain ⟨m13, -, hl13, htrl, hrc13, hf13, hR13⟩ := grp13 hs hcd hrc12
    (Rho1At.frame hI0.rho hfC (by g1013_frame)) hks12
  have hfD := FrameExcept.trans hfC hf13
  have hf1113 := FrameExcept.trans (FrameExcept.trans hf11 hf12) hf13
  refine ⟨m13, ⟨inve_frame hI0 hfD, Acc0.frame hI.acc0 (by norm_num) hfD (by g1013_frame) (by g1013_frame),
    Acc1.frame hacc1 hf1113 (by g1013_frame) (by g1013_frame),
    (hl11.frame (FrameExcept.trans hf12 hf13) (by g1013_frame)),
    (hl12.frame hf13 (by g1013_frame)), hl13, htrl⟩, ?_⟩
  have hR := (((((hR10.trans gP).trans (call_iff.mp hcP)).trans hR11).trans hR12).trans hR13)
  rw [g1013_flag] at hR
  refine hR.mono (le_of_eq ?_)
  unfold gG1013 costP10
  generalize G1013.cost10 = a; generalize G1013.cost11 = c; generalize G1013.cost12 = d
  generalize G1013.cost13 = e; generalize Gas.pass3f10 = f
  omega

end Exp

