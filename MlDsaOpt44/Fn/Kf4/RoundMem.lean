def rM2 (M : ByteArray) (src dst rca : Nat) : ByteArray := row1 (rM1 M src dst rca) src dst (thD0 M src) (thD1 M src) (thD2 M src) (thD3 M src) (thD4 M src)
def rM3 (M : ByteArray) (src dst rca : Nat) : ByteArray := row2 (rM2 M src dst rca) src dst (thD0 M src) (thD1 M src) (thD2 M src) (thD3 M src) (thD4 M src)
