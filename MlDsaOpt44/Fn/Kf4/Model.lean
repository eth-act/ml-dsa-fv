/-- Column parity of the lanes at `src`. -/
def colM (M : ByteArray) (src x : Nat) : UInt256 :=
  colC Ops256 (ldY M (src + 32 * x)) (ldY M (src + 32 * (x + 5))) (ldY M (src + 32 * (x + 10)))
    (ldY M (src + 32 * (x + 15))) (ldY M (src + 32 * (x + 20)))

def thD0 (M : ByteArray) (src : Nat) : UInt256 := dL Ops256 (colM M src 4) (colM M src 1)

def thD1 (M : ByteArray) (src : Nat) : UInt256 := dL Ops256 (colM M src 0) (colM M src 2)

def thD2 (M : ByteArray) (src : Nat) : UInt256 := dL Ops256 (colM M src 1) (colM M src 3)

def thD3 (M : ByteArray) (src : Nat) : UInt256 := dR Ops256 (colM M src 2) (colM M src 4)

def thD4 (M : ByteArray) (src : Nat) : UInt256 := dL Ops256 (colM M src 3) (colM M src 0)

/-- Output row 0: the five chi stores (loads from `M`). -/
def row0 (M : ByteArray) (src dst : Nat) (d0 d1 d2 d3 d4 : UInt256) (rc : UInt256) : ByteArray :=
  stY (stY (stY (stY (stY M (dst + 0)
    (ch00 Ops256 (bv0 Ops256 d0 (ldY M (src + 0))) (bv Ops256 d1 (ldY M (src + 192)) 44) (bv Ops256 d2 (ldY M (src + 384)) 43) rc)) (dst + 32)
    (ch01 Ops256 (bv Ops256 d1 (ldY M (src + 192)) 44) (bv Ops256 d2 (ldY M (src + 384)) 43) (bv Ops256 d3 (ldY M (src + 576)) 21))) (dst + 64)
    (ch02 Ops256 (bv Ops256 d2 (ldY M (src + 384)) 43) (bv Ops256 d3 (ldY M (src + 576)) 21) (bv Ops256 d4 (ldY M (src + 768)) 14))) (dst + 96)
    (ch03 Ops256 (bv Ops256 d3 (ldY M (src + 576)) 21) (bv Ops256 d4 (ldY M (src + 768)) 14) (bv0 Ops256 d0 (ldY M (src + 0))))) (dst + 128)
    (ch04 Ops256 (bv Ops256 d4 (ldY M (src + 768)) 14) (bv0 Ops256 d0 (ldY M (src + 0))) (bv Ops256 d1 (ldY M (src + 192)) 44))

/-- Output row 1: the five chi stores (loads from `M`). -/
