    (ch13 Ops256 (bv Ops256 d1 (ldY M (src + 512)) 45) (bv Ops256 d2 (ldY M (src + 704)) 61) (bv Ops256 d3 (ldY M (src + 96)) 28))) (dst + 288)
    (ch14 Ops256 (bv Ops256 d2 (ldY M (src + 704)) 61) (bv Ops256 d3 (ldY M (src + 96)) 28) (bv Ops256 d4 (ldY M (src + 288)) 20))

/-- Output row 2: the five chi stores (loads from `M`). -/
