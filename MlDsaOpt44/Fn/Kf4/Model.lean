  stY (stY (stY (stY (stY M (dst + 160)
    (ch10 Ops256 (bv Ops256 d3 (ldY M (src + 96)) 28) (bv Ops256 d4 (ldY M (src + 288)) 20) (bv Ops256 d0 (ldY M (src + 320)) 3))) (dst + 192)
    (ch11 Ops256 (bv Ops256 d4 (ldY M (src + 288)) 20) (bv Ops256 d0 (ldY M (src + 320)) 3) (bv Ops256 d1 (ldY M (src + 512)) 45))) (dst + 224)
