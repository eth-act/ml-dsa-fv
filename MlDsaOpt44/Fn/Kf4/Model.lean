import MlDsaOpt44.Layout
/-! Generated by `Kf4/gen_kf4.py`: the word-level model of one `kf4` round.

`Ops α` packages the five word operations of the kernel; `Ops256` is the EVM
semantics (rotations by `4n` bits of the interleaved words), `Ops64` the
per-slot semantics (`rotl64`). The theta, `B` and chi pieces are stated once,
generically, in the exact operand order of the bytecode. -/

namespace MlDsaOpt44.Proofs.Kf4

open EvmSemantics
open EvmSemantics.EVM

structure Ops (α : Type) where
  xor : α → α → α
  and : α → α → α
  or : α → α → α
  not : α → α
  rot : α → Nat → α

/-- `mload(a)`. -/
def ldY (M : ByteArray) (a : Nat) : UInt256 := MachineState.readWord M a

/-- `mstore(a, v)`. -/
def stY (M : ByteArray) (a : Nat) (v : UInt256) : ByteArray :=
  MachineState.writeBytes M (Data.Bytes.natToBytesPadded v.toNat 32) a

/-- `DUP1 PUSH 4n SHL SWAP1 PUSH (256-4n) SHR OR`: 256-bit rotation by `4n`. -/
def rot256 (x : UInt256) (n : Nat) : UInt256 :=
  UInt256.lor (UInt256.shiftRight x (UInt256.ofNat (256 - 4 * n)))
    (UInt256.shiftLeft x (UInt256.ofNat (4 * n)))

def Ops256 : Ops UInt256 := ⟨UInt256.xor, UInt256.land, UInt256.lor, UInt256.lnot, rot256⟩

def Ops64 : Ops UInt64 :=
  ⟨(· ^^^ ·), (· &&& ·), (· ||| ·), (~~~ ·), EvmSemantics.Crypto.Keccak.rotl64⟩

variable {α : Type}

/-- Column parity `C_x` from the lanes `x, x+5, …, x+20`. -/
def colC (O : Ops α) (a0 a1 a2 a3 a4 : α) : α := O.xor a4 (O.xor a3 (O.xor a2 (O.xor a1 a0)))

/-- `D = rot(q, 1) ^ p` (`p = C_{x-1}`, `q = C_{x+1}`). -/
def dL (O : Ops α) (p q : α) : α := O.xor (O.rot q 1) p

/-- `D = p ^ rot(q, 1)`. -/
def dR (O : Ops α) (p q : α) : α := O.xor p (O.rot q 1)

/-- `B = rot(d ^ a, r)`. -/
def bv (O : Ops α) (d a : α) (r : Nat) : α := O.rot (O.xor d a) r

/-- `B = d ^ a` (lane 0, no rotation). -/
def bv0 (O : Ops α) (d a : α) : α := O.xor d a

def ch00 (O : Ops α) (b0 b1 b2 : α) (rc : α) : α := (O.xor rc (O.xor b0 (O.or b2 b1)))

def ch01 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor b0 (O.or b2 (O.not b1)))

def ch02 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor (O.and b2 b1) b0)

def ch03 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor (O.or b2 b1) b0)

def ch04 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor (O.and b1 b2) b0)

def ch10 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor b0 (O.or b2 b1))

def ch11 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor b0 (O.and b2 b1))

def ch12 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor (O.or (O.not b2) b1) b0)

def ch13 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor (O.or b2 b1) b0)

def ch14 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor (O.and b1 b2) b0)

def ch20 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor b0 (O.or b2 b1))

def ch21 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor b0 (O.and b2 b1))

def ch22 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor (O.and b2 (O.not b1)) b0)

def ch23 (O : Ops α) (b0 b1 b2 : α) : α := (O.not (O.xor (O.or b2 b1) b0))

def ch24 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor (O.and b1 b2) b0)

def ch30 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor b0 (O.and b2 b1))

def ch31 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor b0 (O.or b2 b1))

def ch32 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor (O.or b2 (O.not b1)) b0)

def ch33 (O : Ops α) (b0 b1 b2 : α) : α := (O.not (O.xor (O.and b2 b1) b0))

def ch34 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor (O.or b1 b2) b0)

def ch40 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor b0 (O.and b2 (O.not b1)))

def ch41 (O : Ops α) (b0 b1 b2 : α) : α := (O.not (O.xor b0 (O.or b2 b1)))

def ch42 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor (O.and b2 b1) b0)

def ch43 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor (O.or b2 b1) b0)

def ch44 (O : Ops α) (b0 b1 b2 : α) : α := (O.xor (O.and b1 b2) b0)


