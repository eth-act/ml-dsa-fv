    (ch42 Ops256 (bv Ops256 d4 (ldY M (src + 448)) 39) (bv Ops256 d0 (ldY M (src + 480)) 41) (bv Ops256 d1 (ldY M (src + 672)) 2))) (dst + 736)
    (ch43 Ops256 (bv Ops256 d0 (ldY M (src + 480)) 41) (bv Ops256 d1 (ldY M (src + 672)) 2) (bv Ops256 d2 (ldY M (src + 64)) 62))) (dst + 768)
    (ch44 Ops256 (bv Ops256 d1 (ldY M (src + 672)) 2) (bv Ops256 d2 (ldY M (src + 64)) 62) (bv Ops256 d3 (ldY M (src + 256)) 55))

/-- One round: theta from `M`, then the five rows; iota from `ldY M rca`. -/
def roundM (M : ByteArray) (src dst rca : Nat) : ByteArray :=
  let d0 := thD0 M src
  let d1 := thD1 M src
  let d2 := thD2 M src
  let d3 := thD3 M src
  let d4 := thD4 M src
  let M1 := row0 M src dst d0 d1 d2 d3 d4 (ldY M rca)
  let M2 := row1 M1 src dst d0 d1 d2 d3 d4
  let M3 := row2 M2 src dst d0 d1 d2 d3 d4
  let M4 := row3 M3 src dst d0 d1 d2 d3 d4
  row4 M4 src dst d0 d1 d2 d3 d4

/-- One loop iteration: `KS → KB` with `RC4[r]`, then `KB → KS` with `RC4[r+1]`. -/
def iterM (M : ByteArray) (rp : Nat) : ByteArray :=
  roundM (roundM M 0 0x400 rp) 0x400 0 (32 + rp)

