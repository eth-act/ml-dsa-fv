import MlDsaOpt44.Fn.Sponge.Bits
set_option warningAsError true
/-!
# Folding the `opt44_block` normal forms of the inlined networks

`simp only [← …]`-free folds: each lemma rewrites the literal-power normal
form a block leaves behind into the named network.
-/

namespace MlDsaOpt44.Proofs.WP4

theorem sstage_fold96 (y : Nat) :
    (0xffffffff000000000000000000000000ffffffff &&& (y * 79228162514264337593543950336 ||| y)) =
      sstage 96 0xffffffff000000000000000000000000ffffffff y := rfl
theorem sstage_fold48 (y : Nat) :
    (0xffff000000000000ffff000000000000ffff000000000000ffff &&& (y * 281474976710656 ||| y)) =
      sstage 48 0xffff000000000000ffff000000000000ffff000000000000ffff y := rfl
theorem sstage_fold24 (y : Nat) :
    (0xff000000ff000000ff000000ff000000ff000000ff000000ff000000ff &&& (y * 16777216 ||| y)) =
      sstage 24 0xff000000ff000000ff000000ff000000ff000000ff000000ff000000ff y := rfl
theorem sstage_fold12 (y : Nat) :
    (0x0f000f000f000f000f000f000f000f000f000f000f000f000f000f000f000f &&& (y * 4096 ||| y)) =
      sstage 12 0x0f000f000f000f000f000f000f000f000f000f000f000f000f000f000f000f y := rfl
theorem sstage_fold6 (y : Nat) :
    (0x0303030303030303030303030303030303030303030303030303030303030303 &&& (y * 64 ||| y)) =
      sstage 6 0x0303030303030303030303030303030303030303030303030303030303030303 y := rfl
theorem sstage_fold3 (y : Nat) :
    (0x1111111111111111111111111111111111111111111111111111111111111111 &&& (y * 8 ||| y)) =
      sstage 3 0x1111111111111111111111111111111111111111111111111111111111111111 y := rfl
theorem sprNet_fold (v : Nat) :
    sstage 3 0x1111111111111111111111111111111111111111111111111111111111111111
      (sstage 6 0x0303030303030303030303030303030303030303030303030303030303030303
        (sstage 12 0x0f000f000f000f000f000f000f000f000f000f000f000f000f000f000f000f
          (sstage 24 0xff000000ff000000ff000000ff000000ff000000ff000000ff000000ff
            (sstage 48 0xffff000000000000ffff000000000000ffff000000000000ffff
              (sstage 96 0xffffffff000000000000000000000000ffffffff v))))) = sprNet v := rfl

theorem bsw8_fold (x : Nat) :
    ((450552876409790643671482431940419874915447411150352389258589821042463539455 &&& x) * 256 |||
      450552876409790643671482431940419874915447411150352389258589821042463539455 &&& x / 256) =
      bsw8 x := rfl
theorem bsw16_fold (x : Nat) :
    ((1766820105243087041267848467410591083712559083657179364930612997358944255 &&& x) * 65536 |||
      1766820105243087041267848467410591083712559083657179364930612997358944255 &&&
        x % 115792089237316195423570985008687907853269984665640564039457584007913129639936 / 65536) =
      bsw16 x := rfl
theorem bsw32_fold (x : Nat) :
    ((26959946660873538060741835960174461801791452538186943042387869433855 &&& x) * 4294967296 |||
      26959946660873538060741835960174461801791452538186943042387869433855 &&&
        x % 115792089237316195423570985008687907853269984665640564039457584007913129639936 /
          4294967296) = bsw32 x := rfl
theorem bswapNet_fold (x : Nat) : bsw32 (bsw16 (bsw8 x)) = bswapNet x := rfl

end MlDsaOpt44.Proofs.WP4
